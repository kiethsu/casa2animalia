  <script>
    // ===== Charts (these are only for the small charts in this shell) =====
    let appointmentTrendsChart, servicesChart, petsChart, diseaseChart;

    function initDashboard(){
      const ctx1 = document.getElementById("appointmentTrendsChart")?.getContext("2d");
      if (ctx1){
        appointmentTrendsChart = new Chart(ctx1,{ type:"line",
          data:{ labels:["Day 1","Day 2","Day 3","Day 4","Day 5","Day 6","Day 7"],
            datasets:[
              {label:"Pending",data:[0,0,0,0,0,0,0],backgroundColor:"rgba(255,193,7,0.5)",borderColor:"rgba(255,193,7,1)",fill:true},
              {label:"Approved",data:[0,0,0,0,0,0,0],backgroundColor:"rgba(40,167,69,0.5)",borderColor:"rgba(40,167,69,1)",fill:true},
              {label:"Completed",data:[0,0,0,0,0,0,0],backgroundColor:"rgba(23,162,184,0.5)",borderColor:"rgba(23,162,184,1)",fill:true}
            ]},
          options:{responsive:true,maintainAspectRatio:false,scales:{y:{beginAtZero:true}}}
        });
      }

      const ctx2 = document.getElementById("servicesChart")?.getContext("2d");
      if (ctx2){
        servicesChart = new Chart(ctx2,{ type:"pie",
          data:{ labels:["Vaccination","Checkup","Surgery","Grooming"],
            datasets:[{ data:[0,0,0,0],
              backgroundColor:["rgba(255,99,132,0.7)","rgba(54,162,235,0.7)","rgba(255,206,86,0.7)","rgba(75,192,192,0.7)"],
              borderColor:["rgba(255,99,132,1)","rgba(54,162,235,1)","rgba(255,206,86,1)","rgba(75,192,192,1)"],borderWidth:1}]},
          options:{responsive:true,maintainAspectRatio:false}
        });
      }

      const ctx3 = document.getElementById("petsChart")?.getContext("2d");
      if (ctx3){
        petsChart = new Chart(ctx3,{ type:"bar",
          data:{ labels:["Dog","Cat"],
            datasets:[
              {label:"Labrador",data:[0,0],backgroundColor:"rgba(153,102,255,0.7)"},
              {label:"Bulldog",data:[0,0],backgroundColor:"rgba(255,159,64,0.7)"},
              {label:"Persian",data:[0,0],backgroundColor:"rgba(75,192,192,0.7)"},
              {label:"Siamese",data:[0,0],backgroundColor:"rgba(255,205,86,0.7)"}
            ]},
          options:{responsive:true,maintainAspectRatio:false,scales:{x:{stacked:true},y:{stacked:true,beginAtZero:true}}}
        });
      }

      const ctx4 = document.getElementById("diseaseChart")?.getContext("2d");
      if (ctx4){
        diseaseChart = new Chart(ctx4,{ type:"bar",
          data:{ labels:["Parvovirus","Distemper","Rabies","Leptospirosis"],
            datasets:[{label:"Reported Cases",data:[0,0,0,0],backgroundColor:"rgba(255,99,132,0.7)",borderColor:"rgba(255,99,132,1)",borderWidth:1}]},
          options:{responsive:true,maintainAspectRatio:false,scales:{y:{beginAtZero:true}}}
        });
      }

      loadDashboardStats();
    }

    function loadDashboardStats(){
      $.ajax({
        url:'/admin/get-dashboard-stats',method:'GET',cache:false,dataType:'json'
      }).done(function(data){
        if (appointmentTrendsChart && data.appointmentTrends){
          appointmentTrendsChart.data.labels = data.appointmentTrends.labels;
          appointmentTrendsChart.data.datasets[0].data = data.appointmentTrends.pending || [];
          appointmentTrendsChart.data.datasets[1].data = data.appointmentTrends.approved || [];
          appointmentTrendsChart.data.datasets[2].data = data.appointmentTrends.completed || [];
          appointmentTrendsChart.update();
        }
        if (servicesChart && data.servicesData){
          servicesChart.data.labels = data.servicesData.labels || [];
          servicesChart.data.datasets[0].data = data.servicesData.data || [];
          servicesChart.update();
        }
        if (petsChart && data.petsData){
          petsChart.data.labels = data.petsData.labels || [];
          petsChart.data.datasets = data.petsData.datasets || [];
          petsChart.update();
        }
        if (diseaseChart && data.diseaseData){
          diseaseChart.data.labels = data.diseaseData.labels || [];
          diseaseChart.data.datasets[0].data = data.diseaseData.data || [];
          diseaseChart.update();
        }

        $("#doctorsCount").text(data.userStats?.doctors ?? 0);
        $("#hrCount").text(data.userStats?.hr ?? 0);
        $("#customersCount").text(data.userStats?.customers ?? 0);

        const feedEl = $("#activityFeed"); feedEl.empty();
        (data.activityFeed || []).forEach(item => feedEl.append(`<li class="list-group-item">${item}</li>`));
      }).fail(err => console.error('Error loading dashboard stats:', err));
    }

    /* ===== Layout helpers ===== */
    function isMobile(){ return $(window).width() < 992; }
    function showSidebar(){
      $('#sidebar').addClass('active');
      if (isMobile()){ $('#sidebarOverlay').addClass('show'); $('body').addClass('sidebar-open'); }
    }
    function hideSidebar(){
      $('#sidebar').removeClass('active');
      if (isMobile()){ $('#sidebarOverlay').removeClass('show'); $('body').removeClass('sidebar-open'); }
    }
function setSubNavFor(page){
  let title =
    page === 'dashboard'       ? 'Admin Dashboard' :
    page === 'accounts'        ? 'Accounts' :
    page === 'petlist'         ? 'Pet List' :
       page === 'patient'         ? 'Patient' :   // <-- ADD THIS
    page === 'inventory'       ? 'Inventory' :
    page === 'sales-report'    ? 'Sales Report' :
    page === 'upcoming'        ? 'Upcoming' :
    page === 'notification'   ? 'Notification' :
 page === 'reservation'     ? 'Reservation' :     // ← ADD THIS
    page === 'staff-schedule'  ? 'Staff Schedule' :   // <-- add this
    page === 'services'        ? 'Services' :
    page === 'pet-details'     ? 'Pet Details' :
    page === 'profile'         ? 'Profile' : 'Settings';

  $('#subnav-title').text(title).show();
  const topbarHeight = $('#topbar').outerHeight() || 56;
  const subnavHeight = $('#sub-nav').outerHeight();
  $('.wrapper').css('padding-top', (topbarHeight + subnavHeight) + 'px');
}


    // ===== Lifecycle glue for SPA partial reloads =====
  let __currentPage = null;
  let __navBusy = false;

function runPageInit(page){
  if (page === 'dashboard'){
    window.SalesOverview && window.SalesOverview.init();
    window.InventoryOverview && window.InventoryOverview.init && window.InventoryOverview.init();
    window.Appointments && window.Appointments.init && window.Appointments.init();
    wireDashboardTabRefreshes();
  }
  if (page === 'upcoming'){
    // upcoming.ejs attaches a module to window.Upcoming
    window.Upcoming && window.Upcoming.init && window.Upcoming.init();
  }
}
function runPageDestroy(page){
  if (page === 'dashboard'){
    window.SalesOverview && window.SalesOverview.destroy && window.SalesOverview.destroy();
    window.InventoryOverview && window.InventoryOverview.destroy && window.InventoryOverview.destroy();
    window.Appointments && window.Appointments.destroy && window.Appointments.destroy();
    $('#main-content').off('shown.bs.tab.dashboardTabs');
  }
  if (page === 'upcoming'){
    window.Upcoming && window.Upcoming.destroy && window.Upcoming.destroy();
  }
}
  function wireDashboardTabRefreshes() {
    // Delegated — works for content loaded via .load()
    $('#main-content').on('shown.bs.tab.dashboardTabs', 'a[data-toggle="tab"]', function (e) {
      const target = $(e.target).attr('href'); // '#salesOverview' | '#inventoryOverview' | '#appointmentTrends'
      if (target === '#appointmentTrends') {
        // ensure charts/values render even if the tab was hidden at init time
        window.Appointments && (window.Appointments.refresh ? window.Appointments.refresh() : window.Appointments.init && window.Appointments.init());
      } else if (target === '#salesOverview') {
        window.SalesOverview && window.SalesOverview.init && window.SalesOverview.init(); // idempotent
      }
    });
  }
// --- Silent access-token refresh helper (coalesces concurrent calls) ---
let __refreshInFlight = null;
function refreshToken() {
  if (__refreshInFlight) return __refreshInFlight;
  __refreshInFlight = $.ajax({
    url: '/refresh-token',
    type: 'POST',
    xhrFields: { withCredentials: true }
  })
  .then(() => true)
  .catch(() => false)
  .always(() => { __refreshInFlight = null; });

  return __refreshInFlight;
}

  // ===== Content loader (AJAX) =====
// ===== Content loader (AJAX) =====
function loadContent(page, basePath = '/admin/'){
  // No-op if already showing this page
  if (__currentPage === page) return;

  // Prevent stacking loads
  if (__navBusy) return;
  __navBusy = true;
  $('.menu-item').css('pointer-events','none').addClass('disabled');

  if (__currentPage) runPageDestroy(__currentPage);

  const url = `${basePath}${page}`;
  const doLoad = () => {
    $("#main-content").load(url, function(_res, status, xhr){
      __navBusy = false;
      $('.menu-item').css('pointer-events','').removeClass('disabled');

      if (status === 'error'){
        if (xhr && xhr.status === 401) {
          return refreshToken().then(ok => {
            if (ok) doLoad();
            else window.location.href = '/login';
          });
        }
        $("#main-content").html(
          `<div class="alert alert-danger mt-3">Failed to load <b>${page}</b>. ${xhr?.status || ''} ${xhr?.statusText || ''}</div>`
        );
      } else {
        runPageInit(page);
        setSubNavFor(page);
        __currentPage = page;
      }
    });
  };
  doLoad();
}


    $(document).ready(function(){
      if (isMobile()) hideSidebar(); else showSidebar();

      // menu toggle (mobile)
      $('#menu-toggle').on('click', function(){
        if (!isMobile()) return;
        $('#sidebar').hasClass('active') ? hideSidebar() : showSidebar();
      });
      $('#sidebarOverlay').on('click', hideSidebar);

      // submenu collapse
      $('#settingsSubmenu').collapse({ toggle:false });
      $('.dropdown-toggle').on('click', function(e){
        e.preventDefault();
        $($(this).data('target')).collapse('toggle');
      }).attr('aria-expanded','false');
      $('#settingsSubmenu')
        .on('shown.bs.collapse', ()=>$('.dropdown-toggle').attr('aria-expanded','true'))
        .on('hidden.bs.collapse', ()=>$('.dropdown-toggle').attr('aria-expanded','false'));

    $('.menu-item').on('click', function(e){
  const href = $(this).attr('href');
  if (href && href !== '#') return; // allow /logout
  e.preventDefault();

  if (__navBusy) return; // drop rapid clicks

  const key = $(this).data('content');
  if (key === __currentPage) return; // already here

  $('.menu-item').removeClass('active');
  $(this).addClass('active');

  const route = (key === 'accounts') ? 'accounts-view' : key;
  loadContent(route);
  if (isMobile()) hideSidebar();
});

// --- Submenu click: Settings → Pet Details ---
$('.submenu-item').on('click', function(e){
  e.preventDefault();
  if (__navBusy) return;

  const key = $(this).data('content'); // expects "pet-details"
  if (key === __currentPage) return;

  // Active state for submenu
  $('.menu-item').removeClass('active');
  $('.submenu-item').removeClass('active');
  $(this).addClass('active');

  // Keep the Settings submenu open
  $('#settingsSubmenu').collapse('show');
  $('.dropdown-toggle').attr('aria-expanded','true');

  // Load the partial at /admin/pet-details
 // NEW (explicit base path safeguard)
loadContent(key, '/admin/');


  if (isMobile()) hideSidebar();
});

      // initial load
      loadContent('dashboard');

      // keep layout correct on resize
      $(window).on('resize', function(){
        if (isMobile()) hideSidebar(); else showSidebar();
        setSubNavFor($('.menu-item.active').data('content') || 'dashboard');
      });

      // optional avatar change
      $('#sidebarProfilePic').on('click', function(){
        $('#profilePicInput').click();
      });
      $('#profilePicInput').on('change', function(){
        const file = this.files?.[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = e => $('#sidebarProfilePic').attr('src', String(e.target.result));
        reader.readAsDataURL(file);
      });
    });

    // expose to update sidebar name/pic from inner pages
    window.applyUserToShell = function (user = {}){
      if (user.adminName || user.username){
        $('#sidebarAdminName').text(user.adminName || user.username);
      }
      if (user.profilePic){
        $('#sidebarProfilePic').attr('src', user.profilePic + '?v=' + Date.now());
      }
    };

    // refresh token every 50 minutes
    setInterval(function(){
      $.ajax({
        url:'/refresh-token', type:'POST', xhrFields:{ withCredentials:true }
      }).done(r => console.log('Access token refreshed:', r?.message || 'ok'))
        .fail(xhr => console.error('Error refreshing token:', xhr.responseJSON ? xhr.responseJSON.message : xhr.statusText));
    }, 50 * 60 * 1000);
    // --- Global Bootstrap modal hygiene (works for all loaded pages) ---
(function modalHygiene(){
  // Before any modal shows: close others, clear stray backdrops, hide mobile overlay
  $(document).on('show.bs.modal', '.modal', function () {
    // If some modal is already open, close it (Bootstrap 4 doesn't like multiple)
    $('.modal.show').not(this).modal('hide');

    // Kill any orphan/double backdrops that might've been left by SPA reloads
    // (use a tiny timeout so Bootstrap can insert the new backdrop first)
    setTimeout(function(){
      // keep the topmost one, remove older ones
      $('.modal-backdrop').slice(0, -1).remove();
    }, 0);

    // Ensure drawer overlay isn't stacked under the modal on mobile
    $('#sidebarOverlay').removeClass('show');
  });
// --- Global 401 handler for API calls (NOT page loads handled by loadContent) ---
$(document).ajaxError(function (_evt, jqxhr, settings) {
  if (jqxhr.status !== 401 || !settings || !settings.url) return;
  if (settings.url.indexOf('/refresh-token') !== -1) return;

  // Let loadContent handle GET page partials like /admin/* or /settings/*.
  if ((settings.type || settings.method || 'GET').toUpperCase() === 'GET' &&
      /^\/(admin|settings)\//.test(settings.url)) {
    return;
  }

  // Prevent infinite loops
  if (settings.__retry) return;

  refreshToken().then(ok => {
    if (ok) { settings.__retry = true; $.ajax(settings); }
    else { window.location.href = '/login'; }
  });
});
// Keep token fresh when user comes back to the tab/window
document.addEventListener('visibilitychange', () => {
  if (document.visibilityState === 'visible') refreshToken();
});
window.addEventListener('focus', refreshToken);

  // After a modal hides: if none left, remove any leftover backdrops and body lock
  $(document).on('hidden.bs.modal', function () {
    if ($('.modal.show').length) {
      $('body').addClass('modal-open');           // keep scroll lock if another is open
    } else {
      $('.modal-backdrop').remove();              // nuke leftovers
      $('body').removeClass('modal-open');
    }
  });

  // Bonus: when switching SPA pages, make sure no modal/backdrop lingers
  const _loadContent = window.loadContent;
  window.loadContent = function(page, basePath){
    try {
      $('.modal.show').modal('hide');
      $('.modal-backdrop').remove();
      $('body').removeClass('modal-open');
    } catch(e){}
    _loadContent(page, basePath);
  };
})();

// ONE canonical pair only — handles Dashboard, Upcoming, Staff Schedule
function runPageInit(page){
  if (page === 'dashboard'){
    window.SalesOverview && window.SalesOverview.init && window.SalesOverview.init();
    window.InventoryOverview && window.InventoryOverview.init && window.InventoryOverview.init();
    window.Appointments && window.Appointments.init && window.Appointments.init();
    wireDashboardTabRefreshes();
  } else if (page === 'upcoming'){
    window.Upcoming && window.Upcoming.init && window.Upcoming.init();
  } else if (page === 'staff-schedule'){
    window.StaffSchedule && window.StaffSchedule.init && window.StaffSchedule.init();
  } else if (page === 'reservation'){                 // ← ADD
    window.AdminReservation && window.AdminReservation.init && window.AdminReservation.init();
  }
}

function runPageDestroy(page){
  if (page === 'dashboard'){
    window.SalesOverview && window.SalesOverview.destroy && window.SalesOverview.destroy();
    window.InventoryOverview && window.InventoryOverview.destroy && window.InventoryOverview.destroy();
    window.Appointments && window.Appointments.destroy && window.Appointments.destroy();
    $('#main-content').off('shown.bs.tab.dashboardTabs');
  } else if (page === 'upcoming'){
    window.Upcoming && window.Upcoming.destroy && window.Upcoming.destroy();
  } else if (page === 'staff-schedule'){
    window.StaffSchedule && window.StaffSchedule.destroy && window.StaffSchedule.destroy();
  } else if (page === 'reservation'){                 // ← ADD
    window.AdminReservation && window.AdminReservation.destroy && window.AdminReservation.destroy();
  }
}


  </script>
