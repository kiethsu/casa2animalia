<%
// entries: array of PetList docs from /admin/petlist
// Each entry has: _id, petName, owner { _id, username, cellphone?, email? } OR walk-in fields
const list = Array.isArray(entries) ? entries : [];
%>
<div class="container-fluid petlist-container">
<style>
  /* Page shell: match HR spacing */
  .petlist-container{
    background:#f8f9fa;
    min-height:100vh;
    padding:8px 8px 10px !important;
  }

  /* Search + Filter row */
  .search-wrap{
    display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;
    gap:10px; flex-wrap:wrap;
  }
  .search-wrap .search-icon{ position:absolute; right:calc(420px + 10px); display:none; }
  .search-box{
    width:clamp(220px, 40%, 420px);
    height:36px; border-radius:999px; border:1px solid #d1d5db; padding-left:14px;
    box-shadow: inset 0 0 0 1px rgba(0,0,0,.04);
  }
  .search-box:focus{
    border-color:#93c5fd;
    box-shadow:0 0 0 .15rem rgba(147,197,253,.35);
    outline:none;
  }

  /* Filter segmented buttons */
  .filter-seg .btn{ border-radius:999px; padding:.25rem .6rem; }
  .filter-seg .btn:not(.active){ background:#fff; }
  .filter-seg .btn.active{ color:#fff; background:#0D47A1; border-color:#0D47A1; }

  /* Table wrapper */
  .fixed-table-container{
    max-height:none; overflow-y:visible; overflow-x:auto;
    border:1px solid #e9ecef; border-radius:14px;
    box-shadow:0 3px 12px rgba(30,34,90,0.08);
    background:#fff;
  }
  .fixed-table-container.scrollable{ max-height:600px; overflow-y:auto; }

  /* Table */
  .custom-table{
    width:100%;
    table-layout:fixed;
    border-collapse:separate;
    border-spacing:0;
    margin:0;
  }
  .custom-table thead th{
    position:sticky; top:0; z-index:1;
    background:#0D47A1; color:#fff;
    text-align:center;
    padding:12px;
    font-weight:700; letter-spacing:.02em; text-transform:uppercase; font-size:.75rem;
  }
  .custom-table tbody td{
    text-align:center; padding:12px; color:#0f172a;
    border-top:1px dashed #e9edf5; word-break:break-word;
  }
  .custom-table tbody tr:hover{ background:#f9fbff; }

  .equal-btn{ width:120px; }

  /* Modals z-index */
  .modal { z-index: 5001 !important; }
  .modal-backdrop { z-index: 5000 !important; }

  /* Pet History modal polish */
  #petDetailsModal .modal-dialog { max-width: 900px; }
  #petDetailsModal .modal-content{
    border:0; border-radius:16px; box-shadow:0 20px 60px rgba(0,0,0,.25); overflow:hidden;
  }
  #petDetailsModal .modal-header{
    background: linear-gradient(135deg, #0D47A1, #1E88E5);
    color:#fff; padding:14px 18px; border-bottom:0;
  }
  #petDetailsModal .modal-title{
    font-weight:700; letter-spacing:.3px; font-size:1.05rem; display:flex; align-items:center; gap:8px;
  }
  #petDetailsModal .modal-body{ background:#f9fbff; padding:1rem 1.25rem; }
  #petDetailsModal .modal-footer{ background:#f5f7fb; border-top:0; }

  /* History items */
  .history-item { margin-bottom: 10px; }
  .history-header{
    cursor:pointer; padding:.6rem .85rem; border-radius:10px; border:1px solid #e5e7eb;
    display:flex; align-items:center; justify-content:space-between; transition:filter .15s ease;
  }
  .history-header:hover{ filter:brightness(.98); }
  .history-header i{ transition: transform .2s ease; }
  .history-header[aria-expanded="true"] i { transform: rotate(180deg); }
  .history-content{
    background:#fff; border:1px solid #e5e7eb; border-top:none; border-radius:0 0 10px 10px; padding:.75rem 1rem;
  }

  /* Spinners */
  .page-spinner{
    position:fixed; inset:0; background:rgba(255,255,255,.75); backdrop-filter:blur(1px);
    display:flex; align-items:center; justify-content:center; z-index:6000;
  }
  .page-spinner .spin-card{
    background:#ffffff; border:1px solid #e5e7eb; border-radius:12px; padding:16px 18px;
    box-shadow:0 10px 40px rgba(0,0,0,.15); display:flex; flex-direction:column; align-items:center; gap:8px;
  }
  .page-spinner .spin-label{ font-size:.85rem; color:#334155; }

  .block-spinner{
    position:absolute; inset:0; display:flex; align-items:center; justify-content:center;
    background: rgba(255,255,255,.70); z-index:10; border-radius: inherit;
  }

  .d-none{ display:none !important; }
  .position-relative{ position:relative !important; }

  /* Edit Contact modal styling */
  #editContactModal .modal-dialog { max-width: 420px; }
  #editContactModal .modal-content{
    border:0; border-radius:16px; box-shadow: 0 18px 60px rgba(13,71,161,.25); overflow:hidden;
  }
  #editContactModal .modal-header{
    background: linear-gradient(135deg, #0D47A1, #1976D2);
    color:#fff; border:0; padding:.65rem .9rem;
  }
  #editContactModal .modal-title{
    font-size:.95rem; font-weight:700; letter-spacing:.2px; display:flex; align-items:center; gap:8px;
  }
  #editContactModal .modal-body{ background:#f9fbff; padding:12px 14px; }
  #editContactModal .form-label{ font-size:.8rem; color:#334155; margin-bottom:.25rem; }
  #editContactModal .input-group-text{ background:#eef2ff; border-color:#c7d2fe; }
  #editContactModal .form-control{ border-color:#cbd5e1; }
  #editContactModal .form-control:focus{ border-color:#93c5fd; box-shadow:0 0 0 .15rem rgba(147,197,253,.35); }
  #editContactModal .modal-footer{ background:#f5f7fb; border:0; padding:.55rem .9rem; }
  .btn-loading .spinner-border{ margin-right:6px; }
  .form-hint{ font-size:.75rem; color:#64748b; }
  /* ===== SweetAlert2 toast: match HR look, small size, top-right, above modals ===== */
.swal2-container { z-index: 6002 !important; } /* higher than your modal (5001) & spinner (6000) */
.swal2-container.swal2-top-end > .swal2-popup {
  width: 18rem !important;           /* compact width */
  padding: 8px 10px !important;      /* tighter padding */
  border-radius: 12px !important;    /* softer corners */
  font-size: .90rem !important;      /* smaller text */
  box-shadow: 0 10px 28px rgba(0,0,0,.15) !important;
}
.swal2-container.swal2-top-end > .swal2-popup .swal2-title {
  font-size: .95rem !important;      /* slightly larger title for readability */
}
.swal2-container .swal2-timer-progress-bar {
  height: 3px !important;            /* slim progress bar */
}

@media (max-width: 480px) {
  .swal2-container.swal2-top-end > .swal2-popup { width: 16rem !important; }
}

</style>

<!-- Search + Filter -->
<div class="search-wrap">
  <div class="filter-seg btn-group" role="group" aria-label="Owner type filter">
    <button type="button" class="btn btn-outline-primary btn-sm active" data-type="all" id="filterAll">All</button>
    <button type="button" class="btn btn-outline-primary btn-sm" data-type="walkin" id="filterWalkin">Walk-in</button>
    <button type="button" class="btn btn-outline-primary btn-sm" data-type="account" id="filterAccount">Account</button>
  </div>

  <input type="text" class="form-control form-control-sm search-box" id="petSearchInput" placeholder="Search pets or owners">
</div>

<!-- Table -->
<div class="table-responsive fixed-table-container position-relative" id="petTableWrap">
  <div class="block-spinner d-none" id="tableSpin">
    <div class="text-center">
      <div class="spinner-border text-primary" role="status" aria-label="Loading"></div>
      <div class="small mt-2 text-muted">Loading…</div>
    </div>
  </div>

  <table class="table custom-table mb-0">
    <thead>
      <tr>
        <th>Owner Name</th>
        <th>Mobile</th>
        <th>Email</th>
        <th>Pet Name</th>
        <th>Details</th>
      </tr>
    </thead>
    <tbody id="petTableBody">
      <% if (list.length > 0) { %>
        <% list.forEach(function(e) {
          var hasOwner   = e && e.owner && (e.owner._id || typeof e.owner === 'object');
          var ownerIdStr = (hasOwner && e.owner._id) ? String(e.owner._id) : null;
          var ownerName  = (e && e.owner && e.owner.username) ? e.owner.username : (e.ownerName || '');
          var displayMobile = hasOwner ? (e.owner.cellphone || '') : (e.contactMobile || '');
          var displayEmail  = hasOwner ? (e.owner.email     || '') : (e.contactEmail  || '');
        %>
        <tr id="pet-<%= e._id %>" data-owner-type="<%= hasOwner ? 'account' : 'walkin' %>">
          <td class="ownerName" data-owner="<%= (ownerName || '').toLowerCase() %>">
            <%= ownerName || 'Unknown' %>
            <% if (hasOwner) { %>
              <span class="badge badge-success ml-1">Account</span>
            <% } else { %>
              <span class="badge badge-secondary ml-1">Walk-in</span>
            <% } %>
          </td>
          <td class="ownerPhone"><%= displayMobile || '—' %></td>
          <td class="ownerEmail"><%= displayEmail  || '—' %></td>
          <td class="petName"><%= e.petName %></td>
          <td class="text-center">
            <button
              class="btn btn-info btn-sm equal-btn"
              onclick='viewPetDetails(
                <%- JSON.stringify(e._id) %>,
                <%- JSON.stringify(e.petName || "") %>,
                <%= ownerIdStr ? `"${ownerIdStr}"` : "null" %>,
                <%- JSON.stringify(ownerName) %>
              )'>View History</button>

            <% if (!hasOwner) { %>
              <button class="btn btn-secondary btn-sm equal-btn btn-edit-contact"
                      onclick='openEditContact(
                        "<%= e._id %>",
                        <%- JSON.stringify(e.contactMobile || "") %>,
                        <%- JSON.stringify(e.contactEmail  || "") %>,
                        this
                      )'>
                <i class="fas fa-user-edit mr-1"></i> Edit Contact
              </button>
            <% } %>
          </td>
        </tr>
        <% }); %>
      <% } else { %>
        <tr><td colspan="5" class="text-center">No pets added.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>

