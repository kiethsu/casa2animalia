  /* --- Uniform table typography across all breakdown tables --- */
  .sales-trend-table th, .sales-trend-table td, .breakdown-table th, .breakdown-table td { font-size: 0.9rem; line-height: 1.25rem; }
  .breakdown-table .section-title th, .sales-trend-table .section-title th { text-align: left; background: #fff; font-weight: 700; font-size: 0.95rem; padding: 0.6rem 0.75rem; border-top: 1px solid #e9ecef; }
  .breakdown-table .subheader th, .sales-trend-table .subheader th { font-weight: 700; color: #1c2c45; border-bottom: 1px solid #e9ecef; padding: 0.6rem 0.75rem; }

  /* --- Color coding for cost tables' column headers --- */
