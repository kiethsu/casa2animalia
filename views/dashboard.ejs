            <!-- Services subtotal + Grand total -->
            <tbody>
              <tr class="subtotal-row">
                <td colspan="3" class="text-right">Subtotal – Services</td>
                <td id="salesServicesSubtotal" class="text-right">₱0</td>
              </tr>
              <tr class="grand-total-row">
                <td colspan="3" class="text-right font-weight-bold">Total Sales</td>
                <td id="salesGrandTotal" class="text-right font-weight-bold">₱0</td>
              </tr>
            </tbody>
          </table>
          <!-- /Structured table -->
        </div>
      </div>
    </div>
