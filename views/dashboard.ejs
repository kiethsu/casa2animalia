              </tr>
            </tbody>

            <!-- Products subtotal -->
            <tbody>
              <tr class="subtotal-row">
                <td colspan="3" class="text-right">Subtotal – Products</td>
                <td id="salesProductsSubtotal" class="text-right">₱0</td>
              </tr>
            </tbody>

            <!-- SERVICES -->
            <tbody id="salesServicesSection">
              <tr class="section-title">
                <th colspan="4" class="text-left">Services</th>
              </tr>
              <tr class="subheader">
                <th class="text-left th-servicetype">Service Type</th>
                <th class="text-right th-count">Service Count</th>
                <th class="text-right th-fee">Service Fee</th>
                <th class="text-right th-total">Total Amount</th>
