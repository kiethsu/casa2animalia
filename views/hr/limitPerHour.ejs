<!-- views/hr/limitPerHour.ejs -->
<div class="container-fluid limit-container">
  <style>
    .limit-container{
      background:#f8f9fa;
      min-height:100vh;
      padding:8px !important;
    }
    .settings-card{
      border:1px solid #e9ecef;
      border-radius:16px;
      background:#fff;
      box-shadow:0 3px 12px rgba(30,34,90,0.08);
      padding:10px;
      margin:0;
    }
    .tight-input{
      height:36px;
      border-radius:10px;
      border:1px solid #d1d5db;
      padding:6px 10px;
      box-shadow: inset 0 0 0 1px rgba(0,0,0,.04);
    }
    .tight-input:focus{
      border-color:#93c5fd;
      box-shadow:0 0 0 .15rem rgba(147,197,253,.35);
      outline:none;
    }
    .btn-tight{ height:36px; border-radius:10px; }
  </style>

  <!-- Header removed as requested -->
  <div class="settings-card">
    <form id="limitForm" class="mb-0">
      <div class="form-group mb-2">
        <label for="limitPerHour" class="small text-muted">Limit Per Hour (Default is 5)</label>
        <input
          type="number"
          class="form-control form-control-sm tight-input"
          id="limitPerHour"
          name="limitPerHour"
          min="1" step="1"
          value="<%= (setting && typeof setting.limitPerHour !== 'undefined') ? setting.limitPerHour : 5 %>">
      </div>

      <button type="submit" class="btn btn-primary btn-sm btn-tight" id="btnUpdateLimit">
        Update Limit
      </button>
    </form>
  </div>
</div>

<script>
  // Ensure SweetAlert2 is available (loads CDN if missing)
  function ensureSwal(cb){
    if (window.Swal && typeof Swal.fire === 'function') return cb();
    var s = document.createElement('script');
    s.src = 'https://cdn.jsdelivr.net/npm/sweetalert2@11';
    s.onload = cb;
    document.head.appendChild(s);
  }

  $('#limitForm').on('submit', function(e){
    e.preventDefault();
    var $btn = $('#btnUpdateLimit');
    var limit = $('#limitPerHour').val();

    // simple guard
    var n = parseInt(limit, 10);
    if (isNaN(n) || n < 1){
      ensureSwal(function(){
        Swal.fire({ icon:'warning', title:'Invalid value', text:'Please enter a number of 1 or higher.' });
      });
      return;
    }

    $btn.prop('disabled', true);

    $.ajax({
      url: '/hr/limit-per-hour',
      method: 'POST',
      data: { limitPerHour: limit },
      success: function(response){
        ensureSwal(function(){
          if (response && response.success){
            Swal.fire({
              icon: 'success',
              title: 'Updated!',
              text: 'Limit per hour saved.',
              toast: true,
              position: 'top-end',
              timer: 1600,
              timerProgressBar: true,
              showConfirmButton: false
            });
          } else {
            Swal.fire({
              icon: 'error',
              title: 'Update failed',
              text: (response && response.message) ? response.message : 'Unknown error'
            });
          }
        });
      },
      error: function(){
        ensureSwal(function(){
          Swal.fire({ icon:'error', title:'Server error', text:'Server error while updating limit.' });
        });
      },
      complete: function(){
        $btn.prop('disabled', false);
      }
    });
  });
</script>
