<%
/* ---------- Helpers (local, safe) ---------- */
function pad2(n){ n = parseInt(n,10); if (isNaN(n)) n = 0; return (n<10?'0':'')+n; }
function formatLocalDate(dateStr){
  if(!dateStr) return '';
  var d = new Date(dateStr);
  if(isNaN(d)) return '';
  var yyyy = d.getFullYear();
  var mm = pad2(d.getMonth()+1);
  var dd = pad2(d.getDate());
  return yyyy + '-' + mm + '-' + dd;
}
function safeTimeHHmm(timeStr){
  if(!timeStr || typeof timeStr!=='string') return '00:00';
  var m = timeStr.trim().match(/^(\d{1,2}):?(\d{2})?\s*([AaPp][Mm])?$/);
  if(!m) return '00:00';
  var h = parseInt(m[1],10) || 0;
  var min = parseInt(m[2]||'0',10) || 0;
  var suf = (m[3]||'').toUpperCase();
  if(suf==='PM' && h<12) h+=12;
  if(suf==='AM' && h===12) h=0;
  if(h<0||h>23) h=0;
  if(min<0||min>59) min=0;
  return pad2(h)+':'+pad2(min);
}
function formatTime12(hhmm){
  var parts = (hhmm||'').split(':');
  var h = parseInt(parts[0],10);
  var m = parts[1]||'00';
  if (isNaN(h)) return '—';
  var suffix = h<12 ? 'AM':'PM';
  var h12 = h%12===0 ? 12 : h%12;
  return h12 + ':' + m + ' ' + suffix;
}

/* Prefer per-pet follow-up schedule if present (so reschedules surface here) */
function pickDateTime(r){
  // 1) Prefer per-pet schedule if any
  if (r && Array.isArray(r.pets)) {
    for (var i=0;i<r.pets.length;i++){
      var sch = r.pets[i] && r.pets[i].schedule;
      if (sch && sch.scheduleDate){
        return {
          date: sch.scheduleDate,
          time: sch.scheduleTime || sch.time || r.time || ''
        };
      }
    }
  }
  // 2) Prefer reservation-level schedule over original booked date
  return {
    date: r ? ((r.schedule && r.schedule.scheduleDate) || r.date || r.createdAt) : null,
    time: r ? ((r.schedule && (r.schedule.scheduleTime || r.schedule.time)) || r.time || '') : ''
  };
}


/* ---------- Build unified rows (reservations + retail) ---------- */
const _reservations = Array.isArray(historyReservations) ? historyReservations : [];
const _retail       = Array.isArray(retailSales) ? retailSales : [];

// Reservations (no amount)
const resRows = _reservations.map(r => {
  const dt = pickDateTime(r);
  const dateISO = formatLocalDate(dt.date) || '';
  const time24  = safeTimeHHmm(dt.time);
  const time12  = formatTime12(time24);

  // Normalize status (Canceled→Declined; Approved/Scheduled→Scheduled when follow-up exists)
  var rawStatus = (r.status || '').trim();
  var hasFollowup = !!dt.date;
  var displayStatus =
    rawStatus === 'Canceled' ? 'Declined' :
    ((rawStatus === 'Approved' || rawStatus === 'Scheduled') && hasFollowup) ? 'Scheduled' :
    (rawStatus || 'Done');

  return {
    kind: 'Reservation',
    dateISO, time24, time12,
    owner: r.ownerName || '—',
    service: r.service || '—',
    status: displayStatus
  };
});

// Retail sales
const retailRows = _retail.map(p => {
  const dt = p && p.createdAt ? new Date(p.createdAt) : new Date();
  const dateISO = formatLocalDate(dt.toISOString());
  const time24  = pad2(dt.getHours()) + ':' + pad2(dt.getMinutes());
  const time12  = formatTime12(time24);
  return {
    kind: 'Retail',
    dateISO, time24, time12,
    owner: p.customerName || 'Walk-in',
    service: 'Retail Sale',
    status: 'Retail'
  };
});

// Unified list, newest first
const list = [...resRows, ...retailRows].sort((a,b) => {
  const aKey = (a.dateISO||'') + 'T' + (a.time24||'');
  const bKey = (b.dateISO||'') + 'T' + (b.time24||'');
  return bKey.localeCompare(aKey);
});
%>

<div class="container-fluid history-container">
  <style>
    .history-container{
      background:#f8f9fa; min-height:100vh;
      padding:8px 8px 10px !important;
    }

    /* ===== Filter bar OUTSIDE card ===== */
    .filter-toolbar{
      background:#fff;
      border:1px solid #e9ecef;
      border-radius:16px;
      box-shadow:0 3px 12px rgba(30,34,90,0.06);
      padding:10px;
      margin-bottom:10px;
      display:flex; flex-wrap:wrap; gap:8px; align-items:center;
    }
    .chip-input{
      position:relative; display:flex; align-items:center;
      border:1px solid #d1d5db; border-radius:999px;
      background:#fff; height:36px; padding:0 12px 0 36px;
      min-width: 180px;
      box-shadow: inset 0 0 0 1px rgba(0,0,0,.03);
    }
    .chip-input i{
      position:absolute; left:12px; color:#64748b; font-size:.95rem;
    }
    .chip-input input, .chip-input select{
      border:none; outline:none; width:100%; height:100%; background:transparent;
      font-size:.95rem;
    }
    .btn-pill{ height:36px; border-radius:999px; padding:0 14px; }

    /* ===== Card + full-bleed table ===== */
    .card-shell{
      border:1px solid #e9ecef; border-radius:16px;
      background:#fff; box-shadow:0 3px 12px rgba(30,34,90,0.08);
      overflow:hidden; /* keeps the header corners clean */
    }
    .table-wrap{ padding:0; }            /* full-bleed */
    .fixed-table-container{
      overflow:auto;
      /* height is set dynamically when >10 rows; otherwise auto */
    }
    table.table{ margin:0; table-layout: fixed; }

    /* Full-bleed header styling */
    table thead th{
      position:sticky; top:0; z-index:1;
      background: linear-gradient(135deg, #0D47A1, #1E88E5);
      color:#fff;
      border-bottom:1px solid #0D47A1;
      text-transform:uppercase; font-size:.75rem; letter-spacing:.03em;
      white-space:nowrap; padding:12px;
    }
    table tbody td{ vertical-align: middle; padding:12px; }

    .badge{ border-radius:999px; padding:.35rem .6rem; font-weight:600; font-size:.75rem; }
    .badge-success { background-color:#28a745; }
    .badge-danger  { background-color:#dc3545; }
    .badge-primary { background-color:#007bff; }
    .badge-info    { background-color:#17a2b8; }

    .empty-row td{ color:#94a3b8; }
  </style>

  <!-- ===== FILTERS (outside card, no labels) ===== -->
  <div class="filter-toolbar" id="historyFilters">
    <div class="chip-input" style="flex:1 1 240px;">
      <i class="fas fa-search"></i>
      <input type="text" id="historySearch" placeholder="Search owner/customer or service">
    </div>

    <div class="chip-input" style="width:200px;">
      <i class="fas fa-filter"></i>
      <select id="statusFilter">
        <option value="">All statuses</option>
        <option value="Done">Done</option>
        <option value="Paid">Paid</option>
        <option value="Not Attended">Not Attended</option>
        <option value="Scheduled">Scheduled</option><!-- NEW -->
        <option value="Retail">Retail</option>
      </select>
    </div>

    <div class="chip-input" style="width:180px;">
      <i class="far fa-calendar"></i>
      <input type="date" id="fromDate" placeholder="From">
    </div>

    <div class="chip-input" style="width:180px;">
      <i class="far fa-calendar"></i>
      <input type="date" id="toDate" placeholder="To">
    </div>

    <button class="btn btn-light btn-pill" id="clearFilters">Clear</button>
  </div>

  <!-- ===== TABLE CARD ===== -->
  <div class="card-shell">
    <div class="table-wrap">
      <div class="table-responsive fixed-table-container" id="historyScroller">
        <table class="table table-hover mb-0" id="historyTable">
          <thead>
            <tr>
              <th style="min-width:120px;">Date</th>
              <th style="min-width:110px;">Time</th>
              <th>Owner / Customer</th>
              <th>Service / Type</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody id="historyBody">
            <% if (list.length) { %>
              <% list.forEach(function(row){ %>
                <tr
                  data-date="<%= row.dateISO %>"
                  data-status="<%= row.status %>"
                  data-owner="<%= (row.owner||'').toLowerCase() %>"
                  data-service="<%= (row.service||'').toLowerCase() %>"
                >
                  <td><%= row.dateISO || '—' %></td>
                  <td><%= row.time12 || '—' %></td>
                  <td class="owner"><%= row.owner %></td>
                  <td class="service"><%= row.service %></td>
                  <td>
                    <% if (row.status === 'Not Attended') { %>
                      <span class="badge badge-danger">Not Attended</span>
                    <% } else if (row.status === 'Paid') { %>
                      <span class="badge badge-primary">Paid</span>
                    <% } else if (row.status === 'Retail') { %>
                      <span class="badge badge-info">Retail</span>
                    <% } else if (row.status === 'Scheduled') { %>
                      <span class="badge badge-info">Scheduled</span>
                    <% } else { %>
                      <span class="badge badge-success"><%= row.status %></span>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr class="empty-row"><td colspan="5" class="text-center">No history found.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <div class="mt-2 text-muted small px-3 py-2">
        Tip: Use search + status + date range for precise filtering.
      </div>
    </div>
  </div>
</div>
<script>
  /* ===========================================================
   * ReservationHistory.ejs — client script (updated)
   * - Injects Authorization header (uses authToken passed from server)
   * - Local filtering (search, status, date range) + sticky scroller
   * - SSE auto-refresh when reservations change elsewhere
   * =========================================================== */

  /* ---------- 0) Auth header for all jQuery AJAX calls ---------- */
  (function () {
    // Make sure your route sent: res.render('hr/ReservationHistory', { ..., authToken })
    // and you have jQuery on the page.
    window.AUTH_TOKEN = '<%= typeof authToken !== "undefined" ? authToken : "" %>';

    if (window.jQuery && window.AUTH_TOKEN) {
      $.ajaxSetup({
        beforeSend: function (xhr) {
          try { xhr.setRequestHeader('Authorization', 'Bearer ' + window.AUTH_TOKEN); } catch (_) {}
        }
      });
    }
  })();

  /* ---------- 1) Table filtering + virtual scroller ---------- */
  (function () {
    const $q    = $('#historySearch');
    const $stat = $('#statusFilter');
    const $from = $('#fromDate');
    const $to   = $('#toDate');
    const $body = $('#historyBody');
    const $scroller = $('#historyScroller');
    const $table = $('#historyTable');

    function withinRange(dateStr, fromStr, toStr) {
      // expects YYYY-MM-DD in data-date
      if (!dateStr) return false;
      if (fromStr && dateStr < fromStr) return false;
      if (toStr   && dateStr > toStr)   return false;
      return true;
    }

    // Set scroller height so only N visible rows (plus sticky header) are shown
    function setScrollByRows(targetRows) {
      const $rows = $body.find('tr:visible').not('._empty');
      const count = $rows.length;

      if (count <= targetRows) {
        $scroller.css('height', 'auto');
        return;
      }

      const theadH = $table.find('thead').outerHeight() || 44;
      let rowsH = 0;
      $rows.slice(0, targetRows).each(function () { rowsH += $(this).outerHeight(); });

      // Add a small buffer for borders/shadows
      const total = theadH + rowsH + 2;
      $scroller.css('height', total + 'px');
    }

    function applyFilters() {
      const q = String($q.val() || '').toLowerCase().trim();
      const s = String($stat.val() || '').trim();
      const f = $from.val() || '';
      const t = $to.val()   || '';

      let shown = 0;
      $body.find('tr').not('._empty').each(function () {
        const $r = $(this);
        const owner = String($r.data('owner') || '').toLowerCase();
        const svc   = String($r.data('service') || '').toLowerCase();
        const date  = String($r.data('date') || '').trim();    // YYYY-MM-DD expected
        const st    = String($r.data('status') || '').trim();

        const searchOk = !q || owner.includes(q) || svc.includes(q);
        const statusOk = !s || st === s;
        const dateOk   = (!f && !t) || withinRange(date, f, t);

        const show = searchOk && statusOk && dateOk;
        $r.toggle(show);
        if (show) shown++;
      });

      if (!shown) {
        if (!$body.find('._empty').length) {
          $body.append('<tr class="_empty"><td colspan="5" class="text-center text-muted">No matches found.</td></tr>');
        }
      } else {
        $body.find('._empty').remove();
      }

      setScrollByRows(10);
    }

    // Wire up controls
    $q.on('input', applyFilters);
    $stat.on('change', applyFilters);
    $from.on('change', function () {
      if ($to.val() && $from.val() > $to.val()) $to.val($from.val());
      applyFilters();
    });
    $to.on('change', function () {
      if ($from.val() && $to.val() < $from.val()) $from.val($to.val());
      applyFilters();
    });
    $('#clearFilters').on('click', function () {
      $q.val(''); $stat.val(''); $from.val(''); $to.val(''); applyFilters();
    });

    // Debounced resize to avoid thrashing
    let _rsTimer = null;
    $(window).on('resize', function () {
      clearTimeout(_rsTimer);
      _rsTimer = setTimeout(function () { setScrollByRows(10); }, 100);
    });

    // Kick once on load
    setTimeout(function () { applyFilters(); }, 0);

    // External refresh hook (other scripts can request a repaint)
    window.addEventListener('app:refreshHistory', function () {
      try { applyFilters(); } catch (_) {}
    });
  })();

  /* ---------- 2) Live updates via SSE ---------- */
  (function () {
    var es = null;
    try {
      es = new EventSource('/hr/stream');

      // Any of these events can change what History shows
      var TRIGGER_TYPES = new Set([
        'followup:scheduled',
        'reservation:approved',
        'reservation:declined',
        'reservation:done',
        'reservation:walkin',
        'reservation:notify-state' // if you reflect messaging status
      ]);

      es.onmessage = function (ev) {
        var msg; try { msg = JSON.parse(ev.data); } catch (_) { return; }
        if (msg && TRIGGER_TYPES.has(msg.type)) {
          // Let filters recalc (in case you render dynamic rows client-side),
          // then do a light reload to get fresh data.
          try { window.dispatchEvent(new CustomEvent('app:refreshHistory')); } catch (_) {}
          setTimeout(function () { window.location.reload(); }, 250);
        }
      };
    } catch (e) {
      // SSE not critical; page still works without it
    }

    // Clean up when navigating away
    window.addEventListener('app:beforeNavigate', function () {
      try { es && es.close(); } catch (_) {}
      es = null;
    });
  })();
</script>
