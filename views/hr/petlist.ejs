<!-- SweetAlert2 (toast/popups) -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<!-- Include jQuery UI and Bootstrap scripts -->
<script>
/* ========= GLOBAL SPINNER UTILITIES ========= */
function ensureGlobalSpinner() {
  var $g = $('#globalSpinner');
  if (!$g.length) {
    $('body').append(
      '<div id="globalSpinner" class="page-spinner d-none">' +
        '<div class="spin-card">' +
          '<div class="spinner-border text-primary" role="status" aria-label="Loading"></div>' +
          '<div class="spin-label">Loading…</div>' +
        '</div>' +
      '</div>'
    );
    $g = $('#globalSpinner');
  } else if (!$g.parent().is('body')) {
    $g.appendTo('body');
  }
  return $g;
}
function showPageSpinner(immediate){
  var $g = ensureGlobalSpinner();
  if (immediate) { $g.removeClass('d-none'); return; }
  $g.removeClass('d-none');
}
function hidePageSpinner(){
  $('#globalSpinner').addClass('d-none');
}

/* Prefer short delay on slow connections to show spinner ASAP */
(function setSpinnerDelayStrategy(){
  var conn = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
  window.__NAV_SPINNER_DELAY__ = (conn && (
    (conn.effectiveType && /(^|-)2g$/.test(conn.effectiveType)) ||
    conn.saveData === true ||
    (typeof conn.downlink === 'number' && conn.downlink < 1.2)
  )) ? 80 : 260;

  // also for filter UX
  window.__FILTER_SPINNER_DELAY__ = window.__NAV_SPINNER_DELAY__ || 150;
})();

/* Show spinner before navigation (menu clicks / normal links / form submits) */
(function bindPreNavigationSpinner(){
  var navTimer;
  function preNavSpin(){
    clearTimeout(navTimer);
    navTimer = setTimeout(function(){ showPageSpinner(true); }, window.__NAV_SPINNER_DELAY__ || 200);
  }
  $(document).on('click', 'a[href]:not([target="_blank"]):not([download]):not([data-toggle]):not([data-bs-toggle])', function(){
    var href = $(this).attr('href') || '';
    if (!href || href.startsWith('#') || href.startsWith('javascript:')) return;
    if ($(this).is('[data-skip-spinner="true"]')) return;
    preNavSpin();
  });
  $(document).on('submit', 'form:not([data-skip-spinner="true"])', function(){ preNavSpin(); });
  window.addEventListener('pageshow', function(){ hidePageSpinner(); });
})();

/* ========= SECTION (TABLE) SPINNER ========= */
function showTableSpinner(){ $('#tableSpin').removeClass('d-none'); }
function hideTableSpinner(){ $('#tableSpin').addClass('d-none'); }

/* Global AJAX hooks (covers any $.get/$.post on this page) */
$(document).ajaxStart(function(){ showTableSpinner(); });
$(document).ajaxStop(function(){ hideTableSpinner(); });
$(document).ajaxError(function(){ hideTableSpinner(); });

/* ========= UTIL: SweetAlert toast ========= */
const Toast = (window.Swal && Swal.mixin) ? Swal.mixin({
  toast: true,
  position: 'top-end',
  showConfirmButton: false,
  timer: 1700,
  timerProgressBar: true
}) : null;

function swalSuccess(msg){
  if (Toast) Toast.fire({ icon: 'success', title: msg });
  else alert(msg);
}
function swalError(msg){
  if (window.Swal) Swal.fire({ icon: 'error', title: 'Oops…', text: msg });
  else alert(msg);
}

/* ========= UTIL: Button loading state ========= */
function toggleBtnLoading($btn, isLoading, loadingText){
  if (!$btn || !$btn.length) return;
  if (isLoading) {
    if (!$btn.data('orig-html')) $btn.data('orig-html', $btn.html());
    $btn.addClass('btn-loading').prop('disabled', true)
      .html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>' + (loadingText || 'Processing…'));
  } else {
    const html = $btn.data('orig-html');
    if (html) $btn.html(html);
    $btn.removeClass('btn-loading').prop('disabled', false);
  }
}

/* ========= MODAL HANDLING (details modal) ========= */
function getPetDetailsModal() {
  let $modal = $('body > #petDetailsModal').first();
  if (!$modal.length) {
    $modal = $('#main-content #petDetailsModal').first();
    if ($modal.length) { $modal.appendTo('body'); }
    else {
      $modal = $(
        '<div class="modal fade" id="petDetailsModal" tabindex="-1" role="dialog" aria-hidden="true">' +
          '<div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable" role="document">' +
            '<div class="modal-content">' +
              '<div class="modal-header">' +
               '<h5 class="modal-title"><i class="fas fa-notes-medical"></i> Pet Consultation History <span id="petHdrInline" class="ml-2" style="opacity:.9;"></span></h5>' +

'  <span id="petHdrInline" class="ml-2" style="opacity:.9;"></span>' +
'</h5>' +

              '</div>' +
              '<div class="modal-body" id="petDetailsContent">' +
                '<div class="d-flex align-items-center gap-2">' +
                  '<div class="spinner-border text-primary mr-2" role="status" aria-label="Loading"></div>' +
                  '<span>Loading…</span>' +
                '</div>' +
              '</div>' +
              '<div class="modal-footer">' +
                '<button type="button" class="btn btn-primary" data-dismiss="modal">Close</button>' +
              '</div>' +
            '</div>' +
          '</div>' +
        '</div>'
      );
      $('body').append($modal);
    }
  }
  $('body > #petDetailsModal').not($modal).remove();
  $modal.find('.modal-dialog').addClass('modal-dialog-centered modal-dialog-scrollable');
  return $modal;
}

function colorForKey(key) {
  if (!key) return { bg:'#eef2f7', fg:'#1f2937', border:'#cfd8e3' };
  let hash = 0;
  for (let i = 0; i < key.length; i++) { hash = ((hash << 5) - hash) + key.charCodeAt(i); hash |= 0; }
  const hue    = Math.abs(hash) % 360;
  return {
    bg: `hsl(${hue}, 85%, 93%)`,
    fg: `hsl(${hue}, 60%, 24%)`,
    border: `hsl(${hue}, 45%, 75%)`
  };
}

/* ========= VIEW PET DETAILS ========= */
function viewPetDetails(petId, petName, ownerId, ownerName, species) {

  const $modal   = getPetDetailsModal();
  const $content = $modal.find('#petDetailsContent');
// ⬇️ NEW: update the inline header (Pet name — Species)
const inline = [petName, species].filter(Boolean).join(' — ');
$modal.find('#petHdrInline').text(inline);
  $content.html(
    '<div class="d-flex align-items-center gap-2">' +
      '<div class="spinner-border text-primary mr-2" role="status" aria-label="Loading"></div>' +
      '<span>Loading details…</span>' +
    '</div>'
  );
  $modal.modal('show');

  const params = { petId, petName };
  if (ownerId) params.ownerId = ownerId;
  if (!ownerId && ownerName) params.ownerName = ownerName;
$.get('/hr/get-pet-history', params)
  .done(({ success, pet, history }) => {
// Always update the header first
const inlineHeader = [petName, (pet && pet.species) || species || '']
  .filter(Boolean)
  .join(' — ');
$modal.find('#petHdrInline').text(inlineHeader);

      if (!success) return $content.html('<p>Error loading details.</p>');
      
      if (!history.length) return $content.html('<p>No consultations found.</p>');

      let html = '';
      history.forEach((rec, idx) => {
        const dateStr = new Date(rec.date).toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' });
        const doctor  = (rec.doctor && rec.doctor.username) ? rec.doctor.username : 'Not Assigned';

        const notes = rec.notes || '—';
        const diag  = rec.diagnosis || '—';
        const diseaseText = (Array.isArray(rec.diseases) && rec.diseases.length)
  ? rec.diseases.join(', ')
  : '—';


        const { weight = '—', temperature = '—', observations = '—' } = rec.physical || {};
        const examHtml = `
          <p><strong>Physical Exam:</strong></p>
          <table class="table table-sm table-bordered mb-3">
            <thead class="thead-light"><tr><th>Weight</th><th>Temp</th><th>Observations</th></tr></thead>
            <tbody><tr><td>${weight}</td><td>${temperature}</td><td>${observations}</td></tr></tbody>
          </table>`;

        let srvHtml = '';
        if (rec.services && rec.services.length) {
          srvHtml = `
            <p><strong>Services:</strong></p>
            <table class="table table-sm table-bordered mb-3">
              <thead class="thead-light"><tr><th>Category</th><th>Name</th><th>Details</th><th>File</th></tr></thead>
              <tbody>
                ${rec.services.map(svc => {
                  const fileLink = svc.file ? `<a href="${svc.file.replace(/^public/, '')}" download>📎</a>` : '—';
                  return `<tr><td>${svc.category || '—'}</td><td>${svc.serviceName || '—'}</td><td>${svc.details || '—'}</td><td class="text-center">${fileLink}</td></tr>`;
                }).join('')}
              </tbody>
            </table>`;
        }

        let medHtml = '';
        if (rec.medications && rec.medications.length) {
          medHtml = `
            <p><strong>Medications:</strong></p>
            <table class="table table-sm table-bordered mb-3">
              <thead class="thead-light"><tr><th>Name</th><th>Qty</th><th>Dosage</th><th>Remarks</th></tr></thead>
              <tbody>
                ${rec.medications.map(med => `<tr><td>${med.name || med.medicationName || '—'}</td><td>${med.quantity || '—'}</td><td>${med.dosage || '—'}</td><td>${med.remarks || '—'}</td></tr>`).join('')}
              </tbody>
            </table>`;
        }

        const conf = (rec.confinement && rec.confinement.length) ? rec.confinement.join(', ') : 'N/A';
        let schedHtml = '<p><strong>Next Follow-Up:</strong> N/A</p>';
        if (rec.nextSchedule) {
          const sd = rec.nextSchedule;
          const sdate = new Date(sd.date).toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' });
          schedHtml = `<p><strong>Next Follow-Up:</strong> ${sdate} — ${sd.details}</p>`;
        }

        const doctorLabel = doctor || 'Not Assigned';
        const { bg, fg, border } = colorForKey(doctorLabel);

        html += `
          <div class="history-item">
            <div class="history-header"
                 data-toggle="collapse" data-target="#historyRecord${idx}"
                 aria-expanded="false" aria-controls="historyRecord${idx}"
                 style="background:${bg}; color:${fg}; border-color:${border};">
              <span>${dateStr} — Dr. ${doctorLabel}</span>
              <i class="fas fa-chevron-down"></i>
            </div>
            <div class="collapse" id="historyRecord${idx}">
              <div class="history-content position-relative">
                <button type="button" class="close" onclick="$('#historyRecord${idx}').collapse('hide')">&times;</button>
                <p><strong>Notes:</strong> ${notes}</p>
                ${examHtml}
                <p><strong>Diagnosis:</strong> ${diag}</p>
                <p><strong>Disease(s):</strong> ${diseaseText}</p>
                ${srvHtml}
                ${medHtml}
                <p><strong>Confinement:</strong> ${conf}</p>
                ${schedHtml}
              </div>
            </div>
          </div>`;
      });

      $content.html(html);
    })
    .fail(() => {
      $content.html('<p>Error loading details.</p>');
    });
}

/* ===== Walk-in Contact Editor ===== */
let __ecRowBtn = null;

/* Open modal with trigger button spinner */
function openEditContact(id, mobile, email, btn){
  __ecRowBtn = btn || null;

  const $trigger = $(btn);
  if ($trigger.length) toggleBtnLoading($trigger, true, 'Opening…');

  // populate
  $('#ec_id').val(id);
  $('#ec_mobile').val(mobile || '');
  $('#ec_email').val(email || '');
  $('#ec_applyAll').prop('checked', false);

  // reset validation messages
  $('#ec_mobile_err, #ec_email_err').hide().text('');
  $('#ec_mobile, #ec_email').removeClass('is-invalid');

  // show modal then release button
  $('#editContactModal')
    .one('shown.bs.modal', function(){ if ($trigger.length) toggleBtnLoading($trigger, false); })
    .one('hidden.bs.modal', function(){ if ($trigger.length) toggleBtnLoading($trigger, false); })
    .modal('show');
}

/* Client-side validation */
function validateContactInputs(){
  let ok = true;
  const mobile = $('#ec_mobile').val().trim();
  const email  = $('#ec_email').val().trim();

  const phRe   = /^(\+?63|0)9\d{9}$/;
  const emRe   = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  $('#ec_mobile_err, #ec_email_err').hide().text('');
  $('#ec_mobile, #ec_email').removeClass('is-invalid');

  if (mobile && !phRe.test(mobile)) {
    $('#ec_mobile').addClass('is-invalid');
    $('#ec_mobile_err').text('Mobile must be PH format (09XXXXXXXXX or +639XXXXXXXXXX)').show();
    ok = false;
  }
  if (email && !emRe.test(email)) {
    $('#ec_email').addClass('is-invalid');
    $('#ec_email_err').text('Please enter a valid email address.').show();
    ok = false;
  }
  return ok;
}

/* Save click with button spinner + SweetAlert feedback */
$('#ec_save').on('click', function(){
  if (!validateContactInputs()) {
    swalError('Please fix the highlighted fields.');
    return;
  }

  const $saveBtn = $('#ec_save');
  toggleBtnLoading($saveBtn, true, 'Saving…');

  const id       = $('#ec_id').val();
  const mobile   = $('#ec_mobile').val().trim();
  const email    = $('#ec_email').val().trim();
  const applyAll = $('#ec_applyAll').is(':checked');

  $.post('/hr/petlist/update-contact', {
    id,
    contactMobile: mobile,
    contactEmail: email,
    applyToAllSameWalkin: applyAll
  })
  .done(resp => {
    if (!resp || resp.success !== true) {
      swalError((resp && resp.message) ? resp.message : 'Failed to save.');
      return;
    }

    // Update the current row’s displayed cells
    if (__ecRowBtn) {
      const $tr = $(__ecRowBtn).closest('tr');
      const ownerLabel = $tr.find('.ownerName').text().trim();

      if (applyAll) {
        // Update all walk-in rows with the same owner name
        $('#petTableBody tr').each(function(){
          const $row = $(this);
          const rowOwner = $row.find('.ownerName').text().trim();
          const hasEditBtn = $row.find('.btn-edit-contact').length > 0; // walk-in rows only
          if (hasEditBtn && rowOwner === ownerLabel) {
            $row.find('.ownerPhone').text(mobile || '—');
            $row.find('.ownerEmail').text(email  || '—');
          }
        });
      } else {
        $tr.find('.ownerPhone').text(mobile || '—');
        $tr.find('.ownerEmail').text(email  || '—');
      }
    }

    $('#editContactModal').modal('hide');
    swalSuccess('Contact updated');
  })
  .fail(xhr => {
    const msg = (xhr.responseJSON && xhr.responseJSON.message) || 'Server error.';
    swalError(msg);
  })
  .always(() => {
    toggleBtnLoading($saveBtn, false);
  });
});

/* ========= SORT + FILTER + SCROLL ========= */
let __ownerTypeFilter = 'all';

/* Sort rows by owner name (A→Z) once, and on filter click for safety */
function sortRows(){
  const $tbody = $('#petTableBody');
  const rows = $tbody.children('tr').get();
  rows.sort(function(a, b){
    const an = ($(a).find('.ownerName').data('owner') || '').toString();
    const bn = ($(b).find('.ownerName').data('owner') || '').toString();
    return an.localeCompare(bn, undefined, { sensitivity:'base' });
  });
  $.each(rows, function(_, r){ $tbody.append(r); });
}

function applyFilters(){
  const q = ($('#petSearchInput').val() || '').toLowerCase();

  $('#petTableBody tr').each(function(){
    const $row  = $(this);
    const otype = $row.data('owner-type'); // 'walkin' | 'account'
    const owner = $row.find('.ownerName').text().toLowerCase();
    const pet   = $row.find('.petName').text().toLowerCase();
    const phone = $row.find('.ownerPhone').text().toLowerCase();
    const mail  = $row.find('.ownerEmail').text().toLowerCase();

    const typeOK = (__ownerTypeFilter === 'all') || (__ownerTypeFilter === otype);
    const textOK = (!q) || owner.includes(q) || pet.includes(q) || phone.includes(q) || mail.includes(q);

    $row.toggle(typeOK && textOK);
  });
}

function adjustTableScroll(){
  const visibleCount = $('#petTableBody tr:visible').length;
  const $wrap = $('#petTableWrap');
  if (visibleCount >= 10) $wrap.addClass('scrollable');
  else $wrap.removeClass('scrollable');
}

/* Filter segmented buttons (with spinner on slow signal) */
$('.filter-seg .btn').on('click', function(){
  if ($(this).hasClass('active')) return;

  $('.filter-seg .btn').removeClass('active');
  $(this).addClass('active');
  __ownerTypeFilter = $(this).data('type'); // 'all' | 'walkin' | 'account'

  showTableSpinner();
  setTimeout(function(){
    sortRows();
    applyFilters();
    adjustTableScroll();
    hideTableSpinner();
  }, window.__FILTER_SPINNER_DELAY__ || 150);
});

/* ========= PAGE INIT ========= */
$(function(){
  ensureGlobalSpinner();

  // initial sort + filter + scroll state
  sortRows();
  applyFilters();
  adjustTableScroll();

  // search typing
  $('#petSearchInput').on('input', function(){
    applyFilters();
    adjustTableScroll();
  });
});
</script>
</div>
