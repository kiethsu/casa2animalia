  #editContactModal .form-control:focus{ border-color:#93c5fd; box-shadow:0 0 0 .15rem rgba(147,197,253,.35); }
  #editContactModal .modal-footer{ background:#f5f7fb; border:0; padding:.55rem .9rem; }
