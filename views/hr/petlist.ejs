  }

  /* ===== Spinners ===== */
  .page-spinner{
    position:fixed; inset:0; background:rgba(255,255,255,.75); backdrop-filter:blur(1px);
    display:flex; align-items:center; justify-content:center; z-index:6000;
  }
  .page-spinner .spin-card{
    background:#ffffff; border:1px solid #e5e7eb; border-radius:12px; padding:16px 18px;
