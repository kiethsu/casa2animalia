<style>
  /* ==== Tight page shell (match petlist.ejs spacing) ==== */
  #ddash{
    background-color:#f8f9fa;
    font-family:'Helvetica Neue', Helvetica, Arial, sans-serif;
    color:#333;
  }

  /* Main container beside the sidebar */
  .dashboard-container{
    display:flex;
    flex-wrap:wrap;
    align-items:flex-start;
    gap:12px;                           /* spacing between left/right columns */
    padding:8px 8px 10px !important;    /* same tight padding as petlist.ejs */
    box-sizing:border-box;
  }

  /* Columns become vertical stacks with their own gaps */
  .left-panel{
    flex:1 1 65%;
    min-width:0;
    display:flex;
    flex-direction:column;
    gap:12px;                           /* spacing between greeting, stats, upcoming */
  }
  .right-panel{
    flex:1 1 30%;
    min-width:280px;
    display:flex;
    flex-direction:column;
    gap:12px;
  }

  /* ===== Cards (unified look, tighter spacing) ===== */
  .greeting-card,
  .stat-card,
  .calendar-card,
  .appointments-card{
    background:#fff;
    border:0;
    border-radius:14px;
    padding:12px;
    margin:0;                           /* gaps handle spacing */
    box-shadow:0 3px 12px rgba(30,34,90,0.08);
    box-sizing:border-box;
  }

  /* Remove inner padding for calendar so it occupies the whole card */
  .calendar-card{
    padding:0;
    overflow:hidden;                    /* keep calendar corners clean inside radius */
  }

  /* Greeting */
  .greeting-card h2{
    font-weight:600;
    margin:0 0 .4rem 0;
  }
  .greeting-card p{ margin:0; color:#777; }

  /* Stats row (left column) */
  .stats-row{
    display:flex;
    flex-wrap:wrap;
    gap:12px;                           /* spacing between stat cards */
  }
  .stat-card{
    flex:1 1 180px;
    text-align:center;
  }
  .stat-card h4{
    margin:.5rem 0 .35rem 0;
    font-size:1.05rem;
  }
  .stat-number{
    font-size:1.6rem;
    font-weight:700;
    color:#0D47A1;
  }

  /* Upcoming Appointments */
  .appointments-card .card-title{
    background:#0D47A1;
    color:#fff;
    padding:10px 12px;
    border-radius:10px;
    margin:-12px -12px 12px -12px;      /* stretch to card edges */
    font-weight:600;
  }

  .upcoming-table{
    width:100%;
    border-collapse:separate;
    border-spacing:0;
  }
  .upcoming-table thead th{
    position:sticky; top:0; z-index:1;
    background:#EEF3FF;
    color:#0D47A1;
    text-transform:uppercase;
    font-size:.75rem;
    letter-spacing:.02em;
    padding:10px;
    border:none;
  }
  .upcoming-table tbody td{
    padding:10px;
    border-top:1px dashed #e9ecef !important;
  }
  .upcoming-empty{
    padding:8px;
    color:#777;
    font-size:.95rem;
  }

  /* Flatpickr calendar should fill the card */
  #followUpCalendar{ width:100%; margin:0; padding:0; display:block; }
  .flatpickr-calendar{
    width:100% !important;
    max-width:none;
    box-shadow:none;
    border:none;
    margin:0;                           /* remove any default outer gaps */
  }
  .flatpickr-month{
    background:#f8f9fa; padding:.5rem; border-bottom:1px solid #eee;
  }
  .flatpickr-current-month{
    font-size:1rem; font-weight:600; color:#333; text-align:center;
  }
  .flatpickr-weekdays{ background:#fff; border-bottom:1px solid #eee; }
  .flatpickr-weekday{ color:#555; font-size:.85rem; padding:.5rem 0; }
  .flatpickr-day{
    border:1px solid #ddd;
    border-radius:4px;
    margin:2px;
    width:calc(100%/7 - 4px);
    height:2.5em; line-height:2.5em; text-align:center;
    transition:background .2s, color .2s;
  }
  .flatpickr-day:hover{ background:#007bff; color:#fff; }
  .flatpickr-day.green-highlight{ background:#28a745; color:#fff; }

  /* Responsive */
  @media (max-width: 991px){
    .dashboard-container{ flex-direction:column; }
    .left-panel, .right-panel{ flex-basis:100%; }
  }
</style>

<div id="ddash" class="dashboard-container">

  <!-- LEFT PANEL -->
  <div class="left-panel">
    <!-- Greeting Card -->
    <div class="greeting-card">
      <h2>Hello, Dr. <%= doctor.username %>!</h2>
      <p>Your progress is awesome today. Keep up the great work!</p>
    </div>

    <!-- Stats Row (Total + Follow-ups) -->
    <div class="stats-row">
      <div class="stat-card">
        <div class="stat-number"><%= totalAppointments %></div>
        <h4>Total Appointments</h4>
      </div>
      <div class="stat-card">
        <div class="stat-number"><%= followUps.length %></div>
        <h4>Follow-ups</h4>
      </div>
    </div>

    <!-- Upcoming Appointments (below stats) -->
    <div class="appointments-card">
      <div class="card-title">Upcoming Appointments</div>

      <!-- Table -->
      <div class="table-responsive">
        <table class="upcoming-table">
          <thead>
            <tr>
              <th>Owner Name</th>
              <th>Pet Name</th>
              <th>Service</th>
            </tr>
          </thead>
          <tbody id="upcomingTableBody">
            <tr><td colspan="3" class="upcoming-empty">No upcoming appointments.</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- RIGHT PANEL -->
  <div class="right-panel">
    <!-- Calendar (title removed; calendar fills card) -->
    <div class="calendar-card">
      <div id="followUpCalendar"></div>
    </div>
  </div>
</div>
<script>
  // Helper: local date string YYYY-MM-DD
  function getLocalDateString(dateObj) {
    const year = dateObj.getFullYear();
    const month = ('0' + (dateObj.getMonth() + 1)).slice(-2);
    const day = ('0' + dateObj.getDate()).slice(-2);
    return `${year}-${month}-${day}`;
  }

  $(document).ready(function () {
    const followUps = <%- JSON.stringify(followUps) %>;
// ----- unified helpers for extracting service names -----
function pickServiceName(x){
  if (!x) return '';
  if (typeof x === 'string') return x.trim();
  return (x.serviceName || x.name || x.title || '').toString().trim();
}

function getServiceFromSchedule(sched){
  if (!sched) return '';
  // prefer sched.service (object/string), fallback to sched.scheduleDetails
  const fromObj = pickServiceName(sched.service);
  return fromObj || (sched.scheduleDetails || '').toString().trim();
}

function serviceFromConsultationArray(appt){
  const arr = Array.isArray(appt.services) ? appt.services : [];
  const names = arr.map(pickServiceName).filter(Boolean);
  return names.length ? [...new Set(names)].join(', ') : '';
}

function serviceFromRequested(appt, matchedPet){
  const prs = Array.isArray(appt.petRequests) ? appt.petRequests : [];
  if (!prs.length) return '';

  // match by petId, else by petName
  const pidStr =
    (matchedPet?.petId && typeof matchedPet.petId === 'object' && matchedPet.petId._id)
      ? String(matchedPet.petId._id)
      : (typeof matchedPet?.petId === 'string' ? matchedPet.petId : '');
  const pname = (matchedPet?.petName || '').toLowerCase();

  let pr = null;
  if (pidStr) pr = prs.find(x => String(x.petId) === pidStr);
  if (!pr && pname) pr = prs.find(x => (x.petName || '').toLowerCase() === pname);

  return pr ? pickServiceName(pr.service) : '';
}

    // Build local YYYY-MM-DD dates from followUps (using top-level reservation.schedule)
    const followUpDates = followUps
      .filter(fu => fu.schedule && fu.schedule.scheduleDate)
      .map(fu => getLocalDateString(new Date(fu.schedule.scheduleDate)));

    // helper: read service names from reservation.services (mirrored by add-consultation)
    function serviceFromConsultationArray(appt){
      if (!Array.isArray(appt.services) || !appt.services.length) return '—';
      const names = appt.services
        .map(s => (s.serviceName || s.name || s?.service?.name || s?.service?.serviceName || '').trim())
        .filter(Boolean);
      return names.length ? [...new Set(names)].join(', ') : '—';
    }

    // Renders the table for a specific date
  function renderUpcomingFor(dateStr){
  const $tbody = $("#upcomingTableBody");

  // only reservations whose top-level schedule matches the selected date
  const matches = followUps.filter(appt => {
    if (!appt.schedule || !appt.schedule.scheduleDate) return false;
    const apptDate = getLocalDateString(new Date(appt.schedule.scheduleDate));
    return apptDate === dateStr;
  });

  if (!matches.length){
    $tbody.html(`<tr><td colspan="3" class="upcoming-empty">No upcoming appointments.</td></tr>`);
    return;
  }

  let rowsHtml = "";
  matches.forEach(appt => {
    // Try to find which pet is scheduled on this date (pet-level schedule)
    let petName = '—';
    let svcName = '';

    let matchedPet = null;
    if (Array.isArray(appt.pets)) {
      matchedPet = appt.pets.find(p => {
        if (!p || !p.schedule || !p.schedule.scheduleDate) return false;
        return getLocalDateString(new Date(p.schedule.scheduleDate)) === dateStr;
      }) || null;

      if (matchedPet) {
        // pet name (works whether petId is populated or not)
        petName =
          (matchedPet.petId && typeof matchedPet.petId === 'object' && matchedPet.petId.petName) ||
          matchedPet.petName || '—';

        // 1) best: per-pet schedule
        svcName = getServiceFromSchedule(matchedPet.schedule);
      }
    }

    // 2) fallback: reservation-level schedule
    if (!svcName) {
      svcName = getServiceFromSchedule(appt.schedule);
    }

    // 3) fallback: mirrored services from Consultation (reservation.services[])
    if (!svcName) {
      svcName = serviceFromConsultationArray(appt);
    }

    // 4) fallback: original requested service (petRequests[].service)
    if (!svcName && matchedPet) {
      svcName = serviceFromRequested(appt, matchedPet);
    }

    // finalize
    if (!svcName) svcName = '—';

    rowsHtml += `
      <tr>
        <td>${appt.ownerName || '—'}</td>
        <td>${petName}</td>
        <td>${svcName}</td>
      </tr>
    `;
  });

  $tbody.html(rowsHtml);
}


    // Calendar init
    flatpickr("#followUpCalendar", {
      inline: true,
      dateFormat: "Y-m-d",
      defaultDate: new Date(),
      onReady: function(selectedDates, dateStr, instance){
        // mark highlighted days
        instance.days.childNodes.forEach(function(dayElem){
          if (!dayElem.dateObj) return;
          const d = getLocalDateString(dayElem.dateObj);
          if (followUpDates.includes(d)) dayElem.classList.add("green-highlight");
        });
        // initial table load (today)
        renderUpcomingFor(getLocalDateString(selectedDates[0] || new Date()));
      },
      onDayCreate: function (dObj, dStr, fp, dayElem) {
        const dateString = getLocalDateString(dayElem.dateObj);
        if (followUpDates.includes(dateString)) {
          dayElem.classList.add("green-highlight");
        }
      },
      onChange: function (selectedDates, dateStr) {
        renderUpcomingFor(dateStr);
      }
    });
  });
</script>

