          const pid = String(r.petId || '');
          const pname = String(r.petName || '');
          return !(String(r.reservationId)===String(reservationId) &&
                   (pid===String(petId||'') && pname===String(petName||'')));
        });
        Swal.fire({
          icon: 'success',
          title: 'Done',
          text: resp.allDone ? 'All pets done. Reservation completed.' : 'Pet marked as done.'
        });
      } else {
        Swal.fire('Error', (resp && resp.message) || 'Error marking as done.', 'error');
      }
    })
    .fail(function(){
      Swal.fire('Error', 'Server error while marking as done.', 'error');
    })
    .always(function(){
      if ($btn && $btn.length) unlockBtn($btn);
    });
  });
}

function fetchHistoryWithFallback(params){
  var dfd = $.Deferred();

  $.get('/doctor/get-pet-history', params)
    .done(function(r1){
      if (r1 && r1.success && Array.isArray(r1.history) && r1.history.length){
        dfd.resolve(r1);
      } else {
        $.get('/hr/get-pet-history', params)
          .done(function(r2){
            if (r2 && r2.success) dfd.resolve(r2);
            else dfd.resolve(r1 || { success:true, history:[] });
          })
          .fail(function(){
            dfd.resolve(r1 || { success:true, history:[] });
          });
      }
    })
    .fail(function(){
      dfd.resolve({ success:true, history:[] });
    });

  return dfd.promise();
}

