    /* === Always-6-week calendar helpers === */
function padToSixWeeks($dp){
  const $cal = $dp.find('.ui-datepicker-calendar');
  if (!$cal.length) return;

  const $tbody = $cal.find('tbody');
  const $rows  = $tbody.find('tr');
  if ($rows.length >= 6) return; // already 6 rows

  // Use the last visible cell as base
  const $lastCell = $rows.last().find('td').last();
  let y  = parseInt($lastCell.attr('data-year'), 10);
  let m  = parseInt($lastCell.attr('data-month'), 10);
  let dn = parseInt($lastCell.find('a,.ui-state-default').first().text(), 10);

  let base;
  if (isNaN(y) || isNaN(m) || isNaN(dn)) {
    // Fallback to header if data-* missing
    const monthName = $dp.find('.ui-datepicker-title .ui-datepicker-month').text();
    const yearText  = $dp.find('.ui-datepicker-title .ui-datepicker-year').text();
    const months    = $.datepicker.regional['']?.monthNames || $.datepicker._defaults.monthNames;
    const shownM    = months.indexOf(monthName);
    const shownY    = parseInt(yearText, 10);
    base = new Date(shownY, shownM + 1, 0); // last day of shown month
  } else {
    base = new Date(y, m, dn);
  }

  // Build one extra row (7 days) after 'base'
  const $tr = $('<tr/>');
  for (let i = 1; i <= 7; i++) {
    const nd = new Date(base.getFullYear(), base.getMonth(), base.getDate() + i);
    const $td = $('<td/>', {
      'class'       : 'ui-datepicker-other-month',
      'data-handler': 'selectDay',
      'data-event'  : 'click',
      'data-month'  : nd.getMonth(),
      'data-year'   : nd.getFullYear()
    }).append($('<a/>', { href: '#', 'class': 'ui-state-default', text: nd.getDate() }));
    $tr.append($td);
  }
  $tbody.append($tr);
}
// Safer date keys
function ymdLocal(d){
  const x = new Date(d.getFullYear(), d.getMonth(), d.getDate());
  return x.getFullYear() + '-' + String(x.getMonth()+1).padStart(2,'0') + '-' + String(x.getDate()).padStart(2,'0');
}
function ymdUTC(d){
  return new Date(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate())).toISOString().slice(0,10);
}
// Load stats for prev/cur/next months so padded cells can paint red too
function loadNeighborhoodStats(year, monthIndex){ // monthIndex 0..11
  const cur  = loadFollowupStatsForMonth(year, monthIndex);
  const p    = new Date(year, monthIndex-1, 1);
  const n    = new Date(year, monthIndex+1, 1);
  const prev = loadFollowupStatsForMonth(p.getFullYear(), p.getMonth());
  const next = loadFollowupStatsForMonth(n.getFullYear(), n.getMonth());
  return $.when(cur, prev, next);
}

function repaintFullCells($dp, isFull, keepISO /* rowScheduleISO or "" */){
  const $cells = $dp.find('.ui-datepicker-calendar td');
  $cells.each(function(){
    const $td  = $(this);
    const y    = parseInt($td.attr('data-year'), 10);
    const m    = parseInt($td.attr('data-month'), 10);
    const $btn = $td.find('a,span').first();
    const dnum = parseInt($btn.text(), 10);
    if (isNaN(y) || isNaN(m) || isNaN(dnum)) return;

    const d   = new Date(y, m, dnum);
    const iso = ymd(d);

    if (isFull(d) && iso !== (keepISO || '')) {
      // mark BOTH the cell and the inner button so CSS can easily target either
      $td.addClass('full-date');
      $btn.addClass('full-date ui-state-default'); // ensure it has the state class
      // IMPORTANT: do NOT replace <a> with <span>; keep it clickable
      $td.removeClass('ui-datepicker-unselectable'); // in case older code added it
    } else {
      $td.removeClass('full-date ui-datepicker-unselectable');
      $btn.removeClass('full-date');
    }
  });
}


function initSixWeekDatepicker($el, extraOptions){
  if (!$.fn.datepicker) { console.warn('jQuery UI datepicker missing'); return; }

  const opts = $.extend(true, {
    dateFormat       : 'yy-mm-dd',
    showOtherMonths  : true,
    selectOtherMonths: true,
    onSelect: function(dateText){
      $('#scheduleDate').val(dateText);
      const d = $.datepicker.parseDate('yy-mm-dd', dateText);
      $(this).datepicker('setDate', d);
      setTimeout(() => padToSixWeeks($el), 0);
    },
    onChangeMonthYear: function(){ setTimeout(() => padToSixWeeks($el), 0); }
  }, extraOptions || {});

  $el.datepicker('destroy').datepicker(opts);
  setTimeout(() => padToSixWeeks($el), 0);
}


    function buildRowId(reservationId, petId, petName) {
      if (petId) return `row-${reservationId}-${String(petId)}`;
      const slug = (petName || 'pet').toLowerCase().replace(/\s+/g,'-');
      return `row-${reservationId}-${slug}`;
    }
  function findRow(reservationId, petId, petName){
    const pid = String(petId || '');
    const pname = String((petName || '').toLowerCase());
    return (rowsData || []).find(r =>
      String(r.reservationId) === String(reservationId) &&
      (String(r.petId || '') === pid || String((r.petName || '').toLowerCase()) === pname)
    ) || null;
  }
function escapeHtml(s){
  return String(s||'').replace(/[&<>"']/g, m => (
    {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]
  ));
}
// Tiny helpers (reuse your existing escapeHtml)
  function escHTML(s){ return escapeHtml(s); }
  function escAttr(s){ return String(s||'').replace(/"/g, '&quot;'); }
  function escJS(s){   return String(s||'').replace(/\\/g,'\\\\').replace(/'/g, "\\'"); }

  // Build service label from reservation + pet (client-side fallback)
  function serviceFromReservationAndPet(resv, pet){
    const ps = pet && pet.schedule ? pet.schedule : {};
    if (ps.service && ps.service.name) return ps.service.name;
    if (ps.scheduleDetails) return ps.scheduleDetails;

    // fallback to requested service for this pet
    if (Array.isArray(resv.petRequests) && resv.petRequests.length){
      const pidStr = pet && pet.petId ? String(pet.petId) : null;
      let pr = null;
      if (pidStr) pr = resv.petRequests.find(x => String(x.petId) === pidStr);
      if (!pr) {
        const petName = (pet.petName || (pet.petId && pet.petId.petName) || '').trim();
        pr = resv.petRequests.find(x => String(x.petName || '').trim() === petName);
      }
      if (pr && pr.service) return pr.service;
    }
    return resv.service || '—';
  }
function populateDiseaseSelect(reservationId, petId, petName, preselected){
  const $sel  = $("#diseaseSelect");
  const $hint = $("#diseaseSpeciesHint");

  $sel.prop("disabled", true).html('<option value="">Loading…</option>');
  $hint.text('');

  $.get('/doctor/settings/diseasesBySpecies', { reservationId, petId, petName })
    .done(function(resp){
      let opts = '<option value="">-- Select disease --</option>';
      if (resp && resp.success) {
        if (resp.species) {
          $hint.text('Showing diseases for species: ' + resp.species);
        }
        const arr = Array.isArray(resp.diseases) ? resp.diseases : [];
        if (arr.length) {
          arr.forEach(function(d){
            const label = escHTML(d);
            const val   = escAttr(d);
            opts += `<option value="${val}">${label}</option>`;
          });
        } else {
          opts += '<option value="">(No diseases configured)</option>';
        }
      } else {
        opts += '<option value="">(Error loading diseases)</option>';
      }
      $sel.html(opts);
      if (preselected) $sel.val(preselected);
    })
    .fail(function(){
      $sel.html('<option value="">(Error loading diseases)</option>');
    })
    .always(function(){
      $sel.prop("disabled", false);
    });
}
// --- Multi-disease state + helpers ---
window.__dz = { map: new Map() }; // key = lowercase, value = display label

function dzAdd(label){
  const t = String(label || '').trim();
  if (!t) return;
  const k = t.toLowerCase();
  if (!window.__dz.map.has(k)) window.__dz.map.set(k, t);
  dzRender();
}
function dzRemove(key){
  window.__dz.map.delete(key);
  dzRender();
}
function dzClear(){
  window.__dz.map.clear();
  dzRender();
}
function dzValues(){
  return Array.from(window.__dz.map.values());
}
function dzRender(){
  const $chips = $("#diseaseChips").empty();
  dzValues().forEach(v => {
    const k = v.toLowerCase();
    $chips.append(
      `<li class="list-inline-item d-chip" data-k="${k}">
         ${escHTML(v)}
         <button type="button" class="remove-chip" title="Remove" aria-label="Remove">&times;</button>
       </li>`
    );
  });
  // keep hidden payload ready for submit
  $("#diseasesJson").val(JSON.stringify(dzValues()));
}

  // Insert one row that matches your table markup & handlers
  function insertAssignedRow(r){
    const rid   = String(r.reservationId || r._id || '');
    const pid   = r.petId ? String(r.petId) : '';
    const pname = r.petName || '';
    const rowId = buildRowId(rid, pid, pname);

    // Prevent duplicates
    if (document.getElementById(rowId)) return;

    const hasId   = !!pid;
    const service = r.service || '—';
    const consultBtn = r.hasConsultation ? 'Edit Consultation' : 'Add Consultation';
    const hasSched  = r.petSchedule && r.petSchedule.scheduleDate;

    const html = `
      <tr id="${rowId}"
          data-reservation="${escAttr(rid)}"
          data-pet-id="${escAttr(pid)}"
          data-pet-name="${escAttr(pname)}">
        <td class="ownerName">${escHTML(r.ownerName || '')}</td>
        <td>${escHTML(pname || 'Unknown Pet')}</td>
        <td>${escHTML(service)}</td>

        <td>
          <button class="btn btn-info btn-sm"
                  onclick="viewConsultation(this, '${escJS(rid)}', '${hasId ? escJS(pid) : ''}', '${!hasId ? escJS(pname) : ''}')">
            History
          </button>
        </td>

        <td>
          <button class="btn btn-primary btn-sm fixed-width btn-consult"
                  data-res-id="${escAttr(rid)}"
                  data-pet-id="${hasId ? escAttr(pid) : ''}"
                  data-pet-name="${!hasId ? escAttr(pname) : ''}"
                  onclick="addConsultation('${escJS(rid)}', '${hasId ? escJS(pid) : ''}', '${!hasId ? escJS(pname) : ''}', this)">
            ${consultBtn}
          </button>
        </td>

        <td class="scheduleCell">
          ${
            hasSched
              ? `<button class="btn btn-success btn-sm fixed-width"
                         onclick="openScheduleModal(this, '${escJS(rid)}', '${hasId ? escJS(pid) : ''}', '${!hasId ? escJS(pname) : ''}')">
                   <i class='fas fa-edit'></i> Edit
                 </button>`
              : `<button class="btn btn-secondary btn-sm fixed-width"
                         onclick="openScheduleModal(this, '${escJS(rid)}', '${hasId ? escJS(pid) : ''}', '${!hasId ? escJS(pname) : ''}')">
                   Add
                 </button>`
          }
        </td>

        <td class="doneCell">
          <button class="btn btn-secondary btn-sm"
                  onclick="markAsDone('${escJS(rid)}', '${hasId ? escJS(pid) : ''}', '${!hasId ? escJS(pname) : ''}')">
            Mark as Done
          </button>
        </td>
      </tr>
    `;

    // Prepend to table body & clear empty-state row if present
    const $tbody = $('#patientsTable').find('tbody').first();
    const $empty = $tbody.find('tr td[colspan="7"]:contains("don\'t have consultation")').closest('tr');
    if ($empty.length) $empty.remove();
    $tbody.prepend(html);

    // Keep in-memory rowsData in sync (helps calendar/search)
    (window.rowsData = window.rowsData || []).unshift({
      reservationId: rid,
      ownerName: r.ownerName || '',
      petId: pid || '',
      petName: pname || '',
      service: service || '—',
      petSchedule: r.petSchedule || null,
      hasConsultation: !!r.hasConsultation
    });
  }

// --- Doctor SSE: singleton so we don't open many connections ---
(function initDoctorStreamSingleton(){
  try {
       if (window.IS_ADMIN_VIEW) return; // ← do not open SSE from admin wrapper
    // if we already have an open (or connecting) SSE, reuse it
    if (window.__doctorES && window.__doctorES.readyState !== 2 /* CLOSED */) {
      return;
    }

    const es = new EventSource('/doctor/stream');
    window.__doctorES = es;

    // helpful logs (optional)
    es.onopen  = () => console.log('[SSE] connected');
    es.onerror = (e) => console.warn('[SSE] error/closed', e);

    // === SAME HANDLER BODY YOU ALREADY HAVE ===
    es.onmessage = function(ev){
      let msg;
      try { msg = JSON.parse(ev.data); } catch { return; }
      if (!msg || msg.type !== 'reservation:assigned') return;

      const assignedDoctorId =
        msg.doctorId ||
        (msg.reservation && (msg.reservation.doctor && (msg.reservation.doctor._id || msg.reservation.doctor))) ||
        null;

      if (!assignedDoctorId || String(assignedDoctorId) !== String(window.DOCTOR_ID)) return;

      if (Array.isArray(msg.rows) && msg.rows.length) {
        msg.rows.forEach(insertAssignedRow);
        return;
      }

      const rid = msg.id || (msg.reservation && msg.reservation._id);
      if (!rid) return;

      $.get('/doctor/get-consultation', { reservationId: rid }).done(function(resp){
        if (!resp || !resp.success || !resp.reservation) return;
        const resv = resp.reservation;

        (resv.pets || []).forEach(function(p){
          if (p && p.done) return;

          const petObj = p.petId || p;
          const row = {
            reservationId : String(resv._id),
            ownerName     : resv.ownerName || '',
            petId         : petObj && petObj._id ? String(petObj._id) : '',
            petName       : petObj ? (petObj.petName || p.petName || '') : '',
            service       : serviceFromReservationAndPet(resv, p),
            petSchedule   : p.schedule || null,
            hasConsultation: !!p.hasConsult
          };
          insertAssignedRow(row);
        });
      });
    };

    // close the stream when the tab is going away
    window.addEventListener('beforeunload', function(){
      try { es.close(); } catch(_) {}
    });
  } catch (e) {
    console.warn('SSE unavailable:', e);
  }
})();


// ====== Reusable spinner helpers ======
function modalLoadingHtml(label){
  return ''+
    '<div class="text-center py-4">'+
      '<i class="fas fa-circle-notch fa-spin" style="font-size:20px;"></i>'+
      '<div style="margin-top:8px;">'+ (label || 'Loading…') +'</div>'+
    '</div>';
}

function lockBtn($btn, label){
  if(!$btn || !$btn.length) return;
  var w = $btn.outerWidth();
  $btn.data('orig-html', $btn.html());
  $btn.css('width', w).prop('disabled', true)
      .html('<i class="fas fa-circle-notch fa-spin" style="margin-right:6px;"></i>'+(label||'Loading'));
}
function unlockBtn($btn){
  if(!$btn || !$btn.length) return;
  $btn.prop('disabled', false).css('width','').html($btn.data('orig-html'));
}

