}
/* If a faint hairline ever appears, uncomment the next line:
#scheduleModal #scheduleDatePicker{ margin-top: -1px; } */


/* Base container */
#scheduleModal .ui-datepicker{
  width: 100% !important;
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-top: 0;                    /* no seam under header */
  border-radius: 0 0 12px 12px;     /* square top corners */
  overflow: hidden;
  box-shadow: 0 3px 12px rgba(30,34,90,0.08);
  font-family: inherit;
}



/* Calendar grid */
#scheduleModal .ui-datepicker-calendar{
  width: 100%;
