window.addConsultation  = addConsultation;
window.openScheduleModal = openScheduleModal;
window.viewConsultation  = viewConsultation;
window.markAsDone        = markAsDone;

// These two are also used inline on the little "×" buttons:
window.closeMedication   = closeMedication;
window.closeDiagnosis    = closeDiagnosis;

  </script>

