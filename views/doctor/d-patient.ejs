                 'data-toggle="collapse" data-target="#historyRec'+idx+'" aria-expanded="false" ' +
                 'style="cursor:pointer;background:'+bg+';color:'+fg+';border:1px solid '+border+';border-radius:10px;padding:.6rem .85rem;">' +
              '<span>'+dateStr+' — Dr. '+doctor+'</span>' +
              '<i class="fas fa-chevron-down"></i>' +
            '</div>' +
            '<div class="collapse" id="historyRec'+idx+'">' +
              '<div class="history-content" style="background:#fff;border:1px solid #e5e7eb;border-top:none;border-radius:0 0 10px 10px;padding:.75rem 1rem;">' +
                '<p class="mb-2"><strong>Notes:</strong> ' + (rec.notes || '—') + '</p>' +
                examHtml +
                '<p class="mb-2"><strong>Diagnosis:</strong> ' + (rec.diagnosis || '—') + '</p>' +
                   diseasesHtml + 
                srvHtml +
                medHtml +
                '<p class="mb-2"><strong>Confinement:</strong> ' + conf + '</p>' +
                schedHtml +
              '</div>' +
            '</div>' +
          '</div>';
      });

    $("#consultationDetails").html(headerHtml + html);

    })
    .fail(function(){
      $("#consultationDetails").html('<p class="text-danger mb-0">Server error while fetching history.</p>');
    })
    .always(function(){
      // --- Restore button ---
      $btn.prop('disabled', false).css('width','').html(originalHtml);
    });
}

    // ----------------- Global Calendar (optional UI) -----------------
    var scheduledDates = [];
    (rowsData || []).forEach(function(r){
      if(r.petSchedule && r.petSchedule.scheduleDate){
        var d = new Date(r.petSchedule.scheduleDate).toISOString().slice(0,10);
        if(scheduledDates.indexOf(d) === -1) scheduledDates.push(d);
      }
    });
   function initGlobalCalendar(){
  initSixWeekDatepicker($("#globalCalendarPicker"), {
    inline: true,
    beforeShowDay: function(date){
      const s = $.datepicker.formatDate("yy-mm-dd", date);
      return (scheduledDates.indexOf(s) !== -1) ? [true, "green-highlight", "Scheduled"] : [true, "", ""];
    },
    onSelect: function(dateText){
      const followUps = (rowsData || []).filter(function(r){
        return r.petSchedule && r.petSchedule.scheduleDate &&
               (new Date(r.petSchedule.scheduleDate).toISOString().slice(0,10) === dateText);
      });
      const listHtml = followUps.length
        ? followUps.map(fu =>
            `<div><strong>Owner:</strong> ${fu.ownerName||'-'}
               &nbsp; <strong>Service:</strong> ${fu.petSchedule.scheduleDetails||'-'}
               &nbsp; <strong>Date:</strong> ${new Date(fu.petSchedule.scheduleDate).toISOString().slice(0,10)}
             </div><hr>`
          ).join('')
        : "<div>No follow-ups for this date.</div>";
      $("#followUpList").html(listHtml);

      // keep view synced & padded
      const d = $.datepicker.parseDate('yy-mm-dd', dateText);
      $("#globalCalendarPicker").datepicker('setDate', d);
      setTimeout(() => padToSixWeeks($("#globalCalendarPicker")), 0);
    }
  });
}
(function(){
  // ---- shared helpers ----
  let FU_APPT_LIMIT = null;

  function getLimit(cb){
    if (FU_APPT_LIMIT != null) return cb(FU_APPT_LIMIT);
 $.getJSON('/doctor/settings/appointmentLimit', function(r){

      FU_APPT_LIMIT = Number(r?.limit || 5);
      cb(FU_APPT_LIMIT);
    }).fail(function(){
      FU_APPT_LIMIT = 5;
      cb(5);
    });
  }

  function localToday(){
    const d = new Date();
    d.setMinutes(d.getMinutes() - d.getTimezoneOffset());
    return d.toISOString().slice(0,10); // YYYY-MM-DD
  }

  function ensureFuOptions(){
    const $sel = $('#fuTime');
    if (!$sel.length || $sel.find('option').length) return;

    let html = '';
    for (let hour = 8; hour <= 17; hour++) {
      const suffix = hour < 12 ? 'AM' : 'PM';
      const h12 = (hour % 12 === 0) ? 12 : (hour % 12);
      const label = `${h12}:00 ${suffix}`;
      html += `<option value="${label}" data-hour="${hour}" data-label="${label}">${label}</option>`;
    }
    $sel.html(html);
  }

  function updatePastForSelectedDate(){
    const $sel = $('#fuTime'); if (!$sel.length) return;
    const dateVal = $('#scheduleDate').val() || localToday();
    const today   = localToday();
    const currHr  = new Date().getHours();

    $sel.find('option').each(function(){
      const $opt = $(this);
      const base = $opt.attr('data-label') || $opt.text();
      if (dateVal === today) {
        const slotHr = parseInt($opt.data('hour'), 10);
        if (slotHr < currHr) {
          $opt.prop('disabled', true)
              .attr('data-disabled-by-past','1')
              .text(base + ' - Passed');
          return;
        }
      }
      if ($opt.attr('data-disabled-by-past')) {
        $opt.prop('disabled', false)
            .removeAttr('data-disabled-by-past')
            .text(base);
      }
    });
  }

  function markFullSlots(){
    const $sel = $('#fuTime'); if (!$sel.length) return;
    const dateVal = $('#scheduleDate').val() || localToday();

    // if editing, allow the *currently saved* slot even if full
    const existingIso  = $('#scheduleForm').attr('data-existing-iso')  || '';
    const existingTime = $('#scheduleForm').attr('data-existing-time') || '';

    getLimit(function(limit){
      $sel.find('option').each(function(){
        const $opt = $(this);
        const base = $opt.attr('data-label') || $opt.text();
        const isExisting = (dateVal === existingIso) && (String($opt.val()) === String(existingTime));

    $.ajax({
  url: '/doctor/consult/appointmentCount',
  method: 'GET',
  data: { time: $opt.val(), date: dateVal },
          success: function(r){
            const isFull = Number(r?.count || 0) >= Number(limit || 5);

            if (isFull && !isExisting) {
              $opt.prop('disabled', true)
                  .addClass('full-slot')
                  .attr('data-disabled-by-count','1')
                  .text(base + ' - Full');
            } else if ($opt.attr('data-disabled-by-count')) {
              // only revert if we disabled it in this code path
              $opt.prop('disabled', false)
                  .removeClass('full-slot')
                  .removeAttr('data-disabled-by-count')
                  .text(base);
            }
          }
        });
      });
    });
  }

  function refreshFuTimeUI(){
    ensureFuOptions();
    // store base labels once
    $('#fuTime option').each(function(){
      if (!this.hasAttribute('data-label')) this.setAttribute('data-label', this.textContent);
    });
    $('#fuTimeError').text('');
    updatePastForSelectedDate();
    markFullSlots();
  }
  // keep hidden payload synced and clear inline error as soon as user picks a slot
 // on select change
$(document).on('change', '#fuTime', function () {
  $('#scheduleTime').val($(this).val() || '');
  $('#fuTimeError').text('');
});

// right at the top of submit handler
$('#scheduleTime').val($('#fuTime').val() || $('#scheduleTime').val() || '');


  // ---- wire up ----
  $(document).on('change.fu', '#scheduleDate', refreshFuTimeUI);
  // If your modal id differs, adjust the selector below
  $(document).on('shown.bs.modal.fu', '#scheduleModal', refreshFuTimeUI);

  // First boot (if the form is visible on load)
  $(function(){ refreshFuTimeUI(); });
})();

