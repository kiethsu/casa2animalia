// Cache month stats per YYYY-MM
window.__followupStats = { /* '2025-10': { limit: 10, counts: {'2025-10-02': 7, ...} } */ };

function yyyymm(d){ return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0'); }
function ymd(d){ 
  return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0'); 
}


/**
 * Loads once per month (cached). Server should return:
 * { limit: <number>, counts: { 'YYYY-MM-DD': <count>, ... } }
 * GET /doctor/followup/stats?year=YYYY&month=1..12
 */
function loadFollowupStatsForMonth(year, monthIndex /*0-11*/){
  const key = year + '-' + String(monthIndex+1).padStart(2,'0');
  if (window.__followupStats[key]) {
    return $.Deferred().resolve(window.__followupStats[key]).promise();
  }

  return $.get('/doctor/followup/stats', { year, month: (monthIndex+1) }) // month is 1..12
    .then(function(resp){
      const data = {
        limit: Number((resp && resp.limit) || 0),
        counts: (resp && resp.counts) || {}
      };
      window.__followupStats[key] = data;
      return data;
    }, function(){
      const data = { limit: 0, counts: {} }; // fail-open (no cap)
      window.__followupStats[key] = data;
      return data;
    });
}
// Safe-define helpers once (won’t overwrite if you already added them elsewhere)
window.__followupStats = window.__followupStats || {}; // cache: { 'YYYY-MM': { limit, counts } }

if (typeof window.yyyymm !== 'function') {
  window.yyyymm = function(d){ return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0'); };
}
if (typeof window.ymd !== 'function') {
  window.ymd = function(d){ return d.getFullYear() + '-' + String(d.getDate()).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0'); };
  // whoops, fixed: month/day
  window.ymd = function(d){ return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0'); };
}
if (typeof window.loadFollowupStatsForMonth !== 'function') {
  // Expects server endpoint: GET /doctor/followup/stats?year=YYYY&month=1..12
  window.loadFollowupStatsForMonth = function(year, monthIndex /*0-11*/){
    const key = year + '-' + String(monthIndex+1).padStart(2,'0');
    if (window.__followupStats[key]) {
      return $.Deferred().resolve(window.__followupStats[key]).promise();
    }
    return $.get('/doctor/followup/stats', { year, month: (monthIndex+1) })
      .then(function(resp){
        const data = {
          limit: Number((resp && resp.limit) || 0),
          counts: (resp && resp.counts) || {}
        };
        window.__followupStats[key] = data;
        return data;
      }, function(){
        const data = { limit: 0, counts: {} };
        window.__followupStats[key] = data;
        return data;
      });
  };
}

