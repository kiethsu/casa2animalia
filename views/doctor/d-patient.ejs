function markAsDone(reservationId, petId, petName){
  Swal.fire({
    title:'Mark as Done?',
    text:'Mark this pet as done?',
    icon:'warning',
    showCancelButton:true,
    confirmButtonText:'Yes, done'
  }).then((res)=>{
    if(!res.isConfirmed) return;

    // lock the clicked button if possible
    const $btn = $(`tr#${buildRowId(reservationId, petId, petName)} .doneCell button`);
    if ($btn.length) lockBtn($btn, 'Saving');

    $.ajax({
      url: '/doctor/mark-done',
      method: 'POST',
      data: { reservationId, petId, petName }
    })
    .done(function(resp){
      if(resp && resp.success){
        const rowId = buildRowId(reservationId, petId, petName);
        const $row = $("#"+rowId);
        $row.find(".doneCell").html('<span class="badge badge-done">Done</span>');
