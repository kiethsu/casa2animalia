function isFull(date){
  const mKey  = yyyymm(date);                         // e.g., "2025-10"
  const stats = window.__followupStats[mKey];
  if (!stats || Number(stats.limit || 0) <= 0) return false;

  // Try local key first, then UTC key (handles server/storage TZ differences)
  const kLocal = ymdLocal(date);
  const kUTC   = ymdUTC(date);
  const cnt    = Number(
    (stats.counts && (stats.counts[kLocal] ?? stats.counts[kUTC])) ?? 0
  );

  const sameAsCurrent = (rowScheduleISO && kLocal === rowScheduleISO);
  return !sameAsCurrent && cnt >= Number(stats.limit);
}


