$("#scheduleForm").off('submit').on('submit', function(e){
  e.preventDefault();
  // ⬇️ ADD THIS LINE HERE (keeps the hidden input in sync with the visible select)
  $('#scheduleTime').val($('#fuTime').val() || $('#scheduleTime').val() || '');
  const $saveBtn = $('#scheduleForm .modal-footer .btn.btn-primary').first();
  lockBtn($saveBtn, 'Saving');

  const dateVal = $("#scheduleDate").val().trim();
  const svcVal  = $("#scheduleServiceName").val().trim();

  // required fields
  if (!dateVal){
    unlockBtn($saveBtn);
    return Swal.fire('Missing date', 'Please pick a follow-up date.', 'warning');
  }
  if (!svcVal){
    unlockBtn($saveBtn);
    return Swal.fire('Missing service', 'Please select a follow-up service.', 'warning');
  }

  /* === FU time: require a valid, enabled selection === */
  const $selTime = $('#fuTime');
  const $optSel  = $selTime.find('option:selected');

  if (!$optSel.length || !$selTime.val()) {
    unlockBtn($saveBtn);
    $('#fuTimeError').text('Please choose a time.');
    return;
  }
  if ($optSel.is(':disabled')) {
    unlockBtn($saveBtn);
    $('#fuTimeError').text('Selected time is not available. Please pick another slot.');
    return;
  }
  $('#fuTimeError').text('');

  // keep this line right after the guard:
  $('#scheduleTime').val($('#fuTime').val() || '');

  // Best-effort guard: block if the selected day is already full (and not the pet’s existing date)
  try{
    const existingIso = $("#scheduleForm").attr('data-existing-iso') || '';
    const d = $.datepicker.parseDate('yy-mm-dd', dateVal);
    if (!isNaN(d)){
      const key   = yyyymm(d);
      const stats = window.__followupStats[key];
      if (stats && Number(stats.limit || 0) > 0) {
        const cnt = Number(stats.counts[ymd(d)] || 0);
        if (dateVal !== existingIso && cnt >= Number(stats.limit)) {
          unlockBtn($saveBtn);
          return Swal.fire('Date full', 'This date has reached the daily limit. Please choose another date.', 'warning');
        }
      }
    }
  } catch(_) { /* ignore guard errors; server will still validate */ }

  const payload = $(this).serialize();

  $.ajax({
    url: '/doctor/add-schedule',
    method: 'POST',
    data: payload,
  }).done(function(response){
    if(!response.success){
      return Swal.fire('Error', response.message || 'Error saving schedule.', 'error');
    }

    const resId   = $("#scheduleReservationId").val();
    const petId   = $("#schedulePetId").val();
    const petName = $("#schedulePetName").val();
    const rowId   = buildRowId(resId, petId, petName);

    $("#"+rowId).find(".scheduleCell").html(`
      <button class="btn btn-success btn-sm fixed-width"
              onclick="openScheduleModal(this,'${resId}','${petId}','${petName}')">
        <i class="fas fa-edit"></i> Edit
      </button>
    `);

    setRowSchedule(resId, petId, petName, response.saved);

    Swal.fire({ icon:'success', title:'Saved', text:'Schedule saved successfully.' })
      .then(()=> $("#scheduleModal").modal("hide"));
  }).fail(function(){
    Swal.fire('Error', 'Server error while saving schedule.', 'error');
  }).always(function(){
    unlockBtn($saveBtn);
  });
});

