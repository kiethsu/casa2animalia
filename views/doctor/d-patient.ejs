/* Ensure no Bootstrap gutters push into the table */
.reservation-container .header-row{ margin-left:0 !important; margin-right:0 !important; }
.reservation-container .header-row > [class^="col-"]{ padding-left:0 !important; padding-right:0 !important; }
/* History modal: open centered with no slide/drop animation */
#viewConsultationModal .modal-dialog{
  transform: none !important;
  transition: none !important;
}
.btn-history{ min-width: 90px; }
#consultationModal .modal-dialog,
#scheduleModal .modal-dialog{
  transform: none !important;
