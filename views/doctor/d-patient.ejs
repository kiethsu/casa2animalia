}
#scheduleModal .ui-state-default:hover{
  background: #f3f7ff !important;
  border-color: #cfe0ff !important;
}

/* Selected day */
#scheduleModal .ui-state-active{
  background: #0047AB !important;
  color: #fff !important;
  border-color: #0047AB !important;
  box-shadow: 0 2px 10px rgba(13,71,161,.25);
}

/* Today marker (jQuery UI’s highlight class) */


/* Smaller screens: slightly shorter day cells */
@media (max-width: 480px){
  #scheduleModal .ui-state-default{
    line-height: 36px;
    min-height: 36px;
  }
}
/* === FIX: constant calendar height + perfectly centered month title === */

/* Size for 6 weeks so the modal never jumps when switching months */
#scheduleModal .ui-datepicker{
  /* tweak these if you change cell or header size */
  --dp-row: 40px;   /* day cell height */
  --dp-gap: 6px;    /* spacing between rows */
  --dp-pad: 10px;   /* inner padding (matches calendar padding) */
  --dp-header: 48px;

  display: grid;
  grid-template-rows: var(--dp-header) 1fr;
  min-height: calc(
    var(--dp-header)            /* header */
    + (var(--dp-row) * 6)       /* 6 rows of days */
    + (var(--dp-gap) * 5)       /* gaps between the 6 rows */
    + (var(--dp-pad) * 2)       /* calendar top/bottom padding */
  );
}

/* Calendar grid spacing uses the variables above */
#scheduleModal .ui-datepicker-calendar{
  padding: var(--dp-pad);
  border-spacing: var(--dp-gap);
}

/* Header becomes a 3-column grid so the title is truly centered */

/* Arrows occupy fixed-width columns so they don't affect centering */
#scheduleModal .ui-datepicker-prev{ grid-column: 1; }
#scheduleModal .ui-datepicker-next{ grid-column: 3; }

/* Keep day cells the exact same height every month */
#scheduleModal .ui-state-default{
  line-height: var(--dp-row);
  min-height: var(--dp-row);
}

/* Small screens: slightly tighter but still constant height */
@media (max-width: 480px){
  #scheduleModal .ui-datepicker{
    --dp-row: 36px;
    --dp-header: 46px;
  }
}
/* other-month days look slightly muted but still visible & clickable */
#scheduleModal .ui-datepicker td.ui-datepicker-other-month .ui-state-default{
  color: #6b7280 !important;
  background: #f9fafb !important;
  border-color: #e5e7eb !important;
  opacity: .95;
}
#scheduleModal .ui-datepicker td.ui-datepicker-other-month .ui-state-default:hover{
  background: #f3f7ff !important;
  border-color: #cfe0ff !important;
}
/* other-month days (Global calendar too) */
#globalCalendarModal .ui-datepicker td.ui-datepicker-other-month .ui-state-default{
  color: #6b7280 !important;
  background: #f9fafb !important;
  border-color: #e5e7eb !important;
  opacity: .95;
}
#globalCalendarModal .ui-datepicker td.ui-datepicker-other-month .ui-state-default:hover{
  background: #f3f7ff !important;
  border-color: #cfe0ff !important;
}
/* Neutral datepicker header — no background; arrows tight beside title */
#scheduleModal .ui-datepicker-header,
#globalCalendarModal .ui-datepicker-header{
  background: transparent;     /* no colored bar */
  color: #111827;
  border: 0;
  padding: 6px 10px;
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  gap: 8px;                    /* arrows sit close to the title */
  min-height: var(--dp-header);
}

#scheduleModal .ui-datepicker-title,
#globalCalendarModal .ui-datepicker-title{
  order: 2;                    /* keep title between arrows */
  font-weight: 600;
  letter-spacing: .2px;
  margin: 0;
}

#scheduleModal .ui-datepicker-prev,
#scheduleModal .ui-datepicker-next,
#globalCalendarModal .ui-datepicker-prev,
#globalCalendarModal .ui-datepicker-next{
  position: static;            /* participate in the flex row */
  width: 28px; height: 28px;
  display: inline-flex;
  align-items: center; justify-content: center;
  border-radius: 6px;
  cursor: pointer;
  color: #374151;              /* dark gray chevrons */
}

#scheduleModal .ui-datepicker-prev:hover,
#scheduleModal .ui-datepicker-next:hover,
#globalCalendarModal .ui-datepicker-prev:hover,
#globalCalendarModal .ui-datepicker-next:hover{
  background: rgba(0,0,0,.05); /* subtle hover; delete this block if you want none */
}

#scheduleModal .ui-datepicker-prev span,
#scheduleModal .ui-datepicker-next span,
#globalCalendarModal .ui-datepicker-prev span,
#globalCalendarModal .ui-datepicker-next span{ display: none; }

#scheduleModal .ui-datepicker-prev::after,
#globalCalendarModal .ui-datepicker-prev::after{ content: '‹'; font-size: 18px; line-height: 1; }

#scheduleModal .ui-datepicker-next::after,
#globalCalendarModal .ui-datepicker-next::after{ content: '›'; font-size: 18px; line-height: 1; }
/* Schedule modal: body flush to header */
#scheduleModal .modal-body{
  padding-top: 0;
}
/* Today = bright green (schedule + global) */
#scheduleModal .ui-state-highlight,
#globalCalendarModal .ui-state-highlight{
  background: #22c55e !important;   /* bright green */
  color: #ffffff !important;
  border-color: #22c55e !important;
  box-shadow: 0 0 0 2px rgba(34,197,94,.18);
}

/* If today is also selected, keep it green instead of blue */
#scheduleModal .ui-state-active.ui-state-highlight,
#globalCalendarModal .ui-state-active.ui-state-highlight{
  background: #16a34a !important;   /* darker green */
  border-color: #16a34a !important;
  color: #ffffff !important;
}
/* ===== Follow-up Service: modern select ===== */
#scheduleModal .service-label{
  display:block;
  font-weight:600;
  color:#111827;
  margin: 2px 0 6px 2px;
}

#scheduleModal .service-select-wrap{
  position: relative;
  border: 1px solid #e5e7eb;
  border-radius: 12px;
  padding: 6px 44px 6px 38px;  /* room for icon + arrow */
  background: #ffffff;
  box-shadow: 0 2px 10px rgba(30,34,90,0.06);
  transition: box-shadow .15s ease, border-color .15s ease;
}

/* left icon */
#scheduleModal .service-select-wrap .svc-ico{
  position:absolute; left:12px; top:50%; transform:translateY(-50%);
  font-size:16px; color:#6b7280; pointer-events:none;
}

/* custom arrow (right) */
#scheduleModal .service-select-wrap::after{
  content: '▾';
  position:absolute; right:12px; top:50%; transform:translateY(-50%);
  font-size:16px; line-height:1; color:#6b7280; pointer-events:none;
}

/* the native select */
#scheduleModal .service-select{
  appearance: none;            /* hide native arrow */
  -webkit-appearance:none;
  -moz-appearance:none;
  border: 0;
  background: transparent;
  width: 100%;
  height: 40px;
  line-height: 40px;
  font-size: 15px;
  color:#111827;
  padding: 0;                  /* padding handled by wrapper */
  outline: none;
  cursor: pointer;
}

/* placeholder look */
#scheduleModal .service-select option[value=""]{
  color:#9ca3af;
}

/* focus ring (when select focused) */
#scheduleModal .service-select-wrap:focus-within{
  border-color:#0D47A1;
  box-shadow: 0 0 0 3px rgba(13,71,161,.12);
}

/* error state (HTML5 required + empty value) */
#scheduleModal .service-select:invalid ~ .svc-hint{
  color:#dc2626;
}
#scheduleModal .service-select:invalid{
  color:#9ca3af;               /* show as placeholder */
}

/* optional tiny hint/inline error */
#scheduleModal .svc-hint{
  margin-top:6px;
  font-size:12px;
  color:#6b7280;
}

/* disabled look */
#scheduleModal .service-select:disabled{
  cursor: not-allowed;
  color:#9ca3af;
}
#scheduleModal .service-select:disabled ~ .svc-ico,
#scheduleModal .service-select:disabled ~ .svc-hint,
#scheduleModal .service-select:disabled ~ .svc-arrow{
  opacity:.6;
}
/* Brand green for success buttons */
.btn-success { background-color:#28a745; border:none; }
.btn-success:hover { background-color:#218838; }
/* Spinner inside the category <select> while loading services */
.select-wrap{ position:relative; width:80%; }
.select-wrap .select-spinner{
  position:absolute;
