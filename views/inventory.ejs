<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Inventory</title>
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
  <style>
    body { background:#f7faff; font-family:'Segoe UI', Arial, sans-serif; }

    /* ===== Match d-history spacing ===== */
    .inventory-container{
      background:#f8f9fa; min-height:100vh;
      padding:8px 8px 10px !important; /* tight like d-history */
    }

    /* ===== Card shell (wraps table) – mirrors d-history ===== */
    .card-shell{
      border:1px solid #e9ecef; border-radius:16px;
      background:#fff; box-shadow:0 3px 12px rgba(30,34,90,0.08);
      overflow:hidden;
    }
    .table-wrap{ padding:0; }
    .fixed-table-container{ overflow:auto; }
    table.table{ margin:0; width:100%; table-layout:fixed; }

    /* Top actions + filters: tighter vertical rhythm */
    .top-actions { margin-top: 8px; margin-bottom: 6px; }
    .filter-container {
      display:flex; gap:.6rem; align-items:center; margin-bottom:10px;
      justify-content:flex-end; flex-wrap:wrap;
    }
    .filter-container .form-control { max-width: 210px; }

    /* KPI cards grid (slightly tighter) */
    .analytics-cards{
      display:grid;
      grid-template-columns:repeat(auto-fit, minmax(220px, 1fr));
      gap:.6rem;
      margin-bottom:.8rem;
      align-items:stretch;
    }
    .analytic-card{
      background:#fff; border-radius:14px;
      box-shadow:0 2px 10px rgba(22,105,187,0.06);
      padding:1rem 1.1rem; color:#1669bb; border:1px solid #e8f0fb;
      display:flex; flex-direction:column; justify-content:space-between;
    }
    .analytic-card > div:first-child{
      font-weight:600; font-size:.98rem; color:#2a5298; opacity:.9; margin-bottom:.35rem;
    }
    .analytic-card > span{ font-size:1.65rem; line-height:1.2; font-weight:800; color:#1b4e8e; }

    /* Inventory table styles (kept your palette) */
    .table-inventory th, .table-inventory td { vertical-align:middle !important; text-align:center; }
    .table-inventory thead th{
      background:#eaf3fd; color:#1669bb; border-bottom:2px solid #1669bb;
      font-weight:600; font-size:.95rem; position:sticky; top:0; z-index:1;
      white-space:nowrap;
    }
    .table-inventory tbody tr{ transition:background .15s ease; }
    .table-inventory tbody tr:hover{ background:#f3f8fe; }
    .table-inventory .btn-info{ background:#1669bb; border:none; }
    .table-inventory .btn-info:hover{ background:#155a9c; }
    .table-inventory .btn-danger{ background:#3570af; border:none; }
    .table-inventory .btn-danger:hover{ background:#285a88; }

    .badge-low{ background:#3570af; color:#fff; }
    .badge-instock{ background:#1669bb; color:#fff; }
    .badge-expiry{ background:#a4caef; color:#1669bb; }

    /* Pagination bar inside the card (like d-history) */
    .pagination-bar{
      display:flex; align-items:center; justify-content:center;
      padding:10px 12px; background:#fff; border-top:1px solid #e9ecef;
    }
    .pagination{ margin-bottom:0; }

    /* Modal Redesign (unchanged) */
    .modal-content.inventory-modal { border-radius:18px; box-shadow:0 4px 24px rgba(22,105,187,0.16); background:#fafdff; border:1.5px solid #e5f1fb; }
    .inventory-modal .modal-header { border-bottom:none; background:#e5f1fb; border-top-left-radius:18px; border-top-right-radius:18px; padding-bottom:.6rem; }
    .inventory-modal .modal-title { color:#1669bb; font-weight:600; font-size:1.35rem; letter-spacing:0.3px; }
    .inventory-modal .modal-body { padding:1.6rem 1.2rem 1.2rem 1.2rem; }
    .inventory-modal .form-row { margin-bottom:1.1rem; display:flex; flex-wrap:wrap; gap:16px 0; }
    .inventory-modal .form-group { margin-bottom:0; padding:0 8px; }
    .inventory-modal label { font-weight:600; color:#1669bb; font-size:.98rem; margin-bottom:.35rem; }
    .inventory-modal .form-control { border-radius:10px; border:1.2px solid #b2cbe9; font-size:1.03rem; background:#f6faff; color:#194673; }
    .inventory-modal .form-control:focus { border-color:#1669bb; box-shadow:0 0 0 0.15rem rgba(22,105,187,0.14); background:#fafdff; }
    .inventory-modal .section-title { color:#2a5298; font-size:1rem; font-weight:700; letter-spacing:.02rem; margin-bottom:.8rem; margin-top:.1rem; }
    .inventory-modal .modal-footer { border-top:none; background:#e5f1fb; border-bottom-left-radius:18px; border-bottom-right-radius:18px; padding-top:.9rem; }
    .inventory-modal .btn-primary { background:#1669bb; border:none; border-radius:8px; padding:.48rem 2.1rem; font-weight:600; font-size:1.02rem; }
    .inventory-modal .btn-outline-secondary { border-radius:8px; font-weight:500; }
    .expiration-inputs { background:#f3f7fc; border-radius:8px; padding:.8rem; margin-top:.25rem; min-height:46px; }

    @media (max-width: 990px){
      .filter-container{ justify-content:stretch; }
      .filter-container .form-control{ max-width:100%; }
    }
    /* === Expired view styling === */
.expired-text { color:#c62828; font-weight:700; }
.modal-expired .modal-header { background:#fdecea !important; }
.modal-expired .modal-title  { color:#c62828 !important; }
/* Make Bootstrap modal/backdrop sit above your shell */
.modal-backdrop { z-index: 5000 !important; }
.modal          { z-index: 5100 !important; }

/* While a modal is open, don't allow interacting with the sidebar */
body.modal-open #sidebar,
body.modal-open #sidebarOverlay {
  pointer-events: none !important;
}
/* === Make inventory table match petlist table (like petlist.ejs) === */
.fixed-table-container{
  /* keep your overflow but ensure the card body is white like petlist */
  background:#fff;
}

/* Petlist-like table polish */
.table-inventory{
  width:100%;
  table-layout:fixed;
  border-collapse:separate;
  border-spacing:0;
  margin:0;
}

/* Header: dark blue, white text, sticky */
.table-inventory thead th{
  position:sticky; top:0; z-index:2;
  background:#0D47A1 !important;  /* same as petlist */
  color:#fff !important;
  text-align:center;
  padding:12px;
  font-weight:700;
  letter-spacing:.02em;
  text-transform:uppercase;
  font-size:.75rem;
  border-bottom:0;                 /* remove the old blue border */
  white-space:nowrap;
}

/* Body cells: dashed separators + hover like petlist */
.table-inventory tbody td{
  text-align:center;
  padding:12px;
  color:#0f172a;
  border-top:1px dashed #e9edf5;
  word-break:break-word;
}

.table-inventory tbody tr:hover{
  background:#f9fbff;              /* subtle hover like petlist */
}

/* Keep your button colors */
.table-inventory .btn-info{ background:#1669bb; border:none; }
.table-inventory .btn-info:hover{ background:#155a9c; }
.table-inventory .btn-danger{ background:#3570af; border:none; }
.table-inventory .btn-danger:hover{ background:#285a88; }
/* ====== Make ALL inventory modals match the table header style ====== */
/* Core look (applies to Add, Edit, Manage Categories) */
.inventory-modal .modal-content{
  border:0;
  border-radius:16px;
  box-shadow:0 20px 60px rgba(13,71,161,.25);
  overflow:hidden;
  background:#fafdff;
}
.inventory-modal .modal-header{
  background:#0D47A1;           /* same blue as table header */
  color:#fff;
  border:0;
  padding:12px 16px;
}
.inventory-modal .modal-title{
  color:#fff;
  text-transform:uppercase;      /* same vibe as table head */
  letter-spacing:.02em;
  font-weight:700;
  font-size:.95rem;
  margin:0;
}
.inventory-modal .close{
  text-shadow:none;
  opacity:1;
  outline:none;
}
.inventory-modal .close span{ color:#fff; }

/* Footer + body polish (optional, matches petlist modals) */
.inventory-modal .modal-body{ background:#f9fbff; }
.inventory-modal .modal-footer{
  background:#f5f7fb;
  border:0;
  padding:.7rem 1rem;
}

/* ====== View Dates modal needs an inline-style override ======
   Use :not(.modal-expired) so the expired theme still wins.  */
#viewDatesModal .modal-content{ 
  border:0; border-radius:16px; box-shadow:0 20px 60px rgba(13,71,161,.25); overflow:hidden;
}
#viewDatesModal .modal-content:not(.modal-expired) .modal-header{
  background:#0D47A1 !important;   /* beats inline style */
  color:#fff !important;
  border:0;
  padding:12px 16px;
}
#viewDatesModal .modal-content:not(.modal-expired) .modal-title{
  color:#fff !important;
  text-transform:uppercase;
  letter-spacing:.02em;
  font-weight:700;
  font-size:.95rem;
}
#viewDatesModal .modal-content:not(.modal-expired) .close span{ color:#fff; }

/* ====== Keep your special Expired look intact ====== */
.modal-expired .modal-header{ background:#fdecea !important; }
.modal-expired .modal-title{ color:#c62828 !important; text-transform:uppercase; letter-spacing:.02em; }

/* (Already present) elevate Bootstrap modals over the shell */
.modal-backdrop { z-index: 5000 !important; }
.modal          { z-index: 5100 !important; }
/* Remove the X button from ALL modal headers on this page */
.modal .modal-header .close{ display:none !important; }

/* Optional: even out header spacing now that the X is gone */
.modal .modal-header{ padding-right:16px !important; }
/* ========== Better KPI cards (4 cards) ========== */
.analytics-cards{
  display:grid;
  grid-template-columns:repeat(auto-fit, minmax(220px, 1fr));
  gap:12px;
  margin-bottom:12px;
  align-items:stretch;
}
.analytic-card{
  position:relative;
  background:#fff;
  border-radius:16px;
  border:1px solid #e6eef9;
  padding:14px 16px;
  box-shadow:0 8px 24px rgba(13,71,161,.06);
  transition:transform .15s ease, box-shadow .15s ease;
}
.analytic-card:hover{
  transform:translateY(-2px);
  box-shadow:0 14px 36px rgba(13,71,161,.10);
}
.analytic-card::before{
  content:"";
  position:absolute; left:0; top:0; right:0; height:4px;
  background:var(--accent, #0D47A1);
  border-top-left-radius:16px; border-top-right-radius:16px;
}
.analytic-card > div:first-child{
  font-weight:700; font-size:.78rem; color:#0D47A1; opacity:.9;
  letter-spacing:.04em; text-transform:uppercase; margin-bottom:.35rem;
}
.analytic-card > span{
  font-size:1.9rem; line-height:1.1; font-weight:800; color:#0f172a;
}

/* Accents per card (order from your render) */
.analytics-cards .analytic-card:nth-child(1){ --accent:#0D47A1; } /* Total */
.analytics-cards .analytic-card:nth-child(2){ --accent:#F59E0B; } /* Low stock */
.analytics-cards .analytic-card:nth-child(3){ --accent:#1E88E5; } /* Near expiry */
.analytics-cards .analytic-card:nth-child(4){ --accent:#E53935; } /* Expired */

/* ========== Filter toolbar ========== */
.filters-toolbar{
  margin:8px 0 12px;
  background:#fff;
  border:1px solid #e6eef9;
  border-radius:16px;
  box-shadow:0 8px 24px rgba(13,71,161,.06);
  padding:10px 12px;
  display:flex; align-items:center;
  justify-content:flex-start;   /* was space-between */
  gap:12px; flex-wrap:wrap;
}
.filters-left{
  display:grid; gap:10px;
  grid-template-columns:repeat(12, minmax(0,1fr));
  flex:1;
}
.filter-block{ grid-column:span 4; min-width:220px; }
.filter-block label{
  display:block; margin:0 0 4px;
  font-size:.72rem; font-weight:800; letter-spacing:.06em;
  text-transform:uppercase; color:#0D47A1;
}
.input-with-icon{ position:relative; }
.input-with-icon .icon{
  position:absolute; left:10px; top:50%; transform:translateY(-50%);
  width:18px; height:18px; color:#5b7bb5; opacity:.85; pointer-events:none;
}
.input-with-icon input.form-control,
.input-with-icon select.form-control{
  padding-left:36px; height:38px; border-radius:10px;
  border:1.2px solid #cfe0ff; background:#f6f9ff;
}
.input-with-icon input.form-control:focus,
.input-with-icon select.form-control:focus{
  border-color:#0D47A1; box-shadow:0 0 0 .15rem rgba(13,71,161,.12); background:#fff;
}


/* Responsive: stack filters nicely */
@media (max-width: 1200px){ .filter-block{ grid-column:span 6; } }
@media (max-width: 768px){ .filter-block{ grid-column:span 12; } }

/* (Keep your existing table + modal styles as-is) */
/* Inline filters (no card) */
.filters-inline{
  margin:8px 0 12px;
  display:flex; align-items:center; justify-content:flex-end;
  gap:10px; flex-wrap:wrap;
}

/* Input-with-icon shells */
.input-with-icon{ position:relative; min-width:220px; }
.input-with-icon .icon{
  position:absolute; left:10px; top:50%; transform:translateY(-50%);
  width:18px; height:18px; color:#5b7bb5; opacity:.85; pointer-events:none;
}
.input-with-icon .form-control{
  height:38px; border-radius:8px;
  border:1px solid #cfe0ff; background:#fff;
  padding-left:36px;
}
.input-with-icon .form-control:focus{
  border-color:#0D47A1; box-shadow:0 0 0 .15rem rgba(13,71,161,.12);
}

/* Responsive */
@media (max-width: 576px){
  .input-with-icon{ min-width:100%; }
}
/* Make SweetAlert2 appear above Bootstrap modals/backdrops */
.swal2-container {
  z-index: 9999 !important; /* higher than .modal (5100) & .modal-backdrop (5000) */
}
/* Button spinner sizing/alignment */
.btn .spinner-border {
  width: 1rem; height: 1rem;
  vertical-align: text-bottom;
  margin-right: .4rem;
}
/* === Make Inventory KPI cards match Sales Report KPI typography === */
#analytics-cards .analytic-card > div:first-child{
  /* label: like .small-label in sales-report */
  font-weight: 400;
  font-size: .82rem;
  color: #6b7280;
  text-transform: none;
  letter-spacing: 0;
  margin-bottom: .35rem; /* keep your spacing */
}

#analytics-cards .analytic-card > span{
  /* value: like .kpi-value in sales-report */
  font-weight: 700;
  font-size: 1.6rem;
  line-height: 1.2;
  color: inherit; /* keeps your existing color */
}

  </style>
</head>
<body>
<div class="container-fluid inventory-container">

  <!-- Actions -->
  <div class="d-flex justify-content-end align-items-center top-actions">
<button id="btnManageCategories" class="btn btn-outline-primary mr-2" data-toggle="modal" data-target="#manageCategoriesModal">Manage Categories</button>
<button id="btnOpenAddModal" class="btn btn-primary" data-toggle="modal" data-target="#addModal" style="background:#1669bb;border:none;">+ Add Item</button>

  </div>

  <!-- KPI Cards -->
  <div class="analytics-cards" id="analytics-cards"></div>
<!-- Filters (no reset button) -->
<!-- Filters (minimal: no card, no labels) -->
<div class="filters-inline">
  <!-- Search -->
  <div class="input-with-icon">
    <span class="icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0016 9.5 6.5 6.5 0 109.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0A4.5 4.5 0 1114 9.5 4.5 4.5 0 019.5 14z"/></svg>
    </span>
    <input type="text" id="searchBar" class="form-control" placeholder="Search by name">
  </div>

  <!-- Category (auto-scroll when >10 options) -->
  <div class="input-with-icon">
    <span class="icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M10 4l2 2h8a2 2 0 012 2v8a2 2 0 01-2 2H4a2 2 0 01-2-2V6a2 2 0 012-2h6z"/></svg>
    </span>
    <select
      id="categoryFilter"
      class="form-control"
      size="1"
      onfocus="if(this.options.length>10){this.size=10}"
      onblur="this.size=1"
      onchange="this.size=1; this.blur();"
    >
      <option value="">All Categories</option>
    </select>
  </div>

  <!-- Status -->
  <div class="input-with-icon">
    <span class="icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M3 5h18l-7 8v5l-4 2v-7L3 5z"/></svg>
    </span>
    <select id="statusFilter" class="form-control">
      <option value="">All Status</option>
      <option value="lowstock">Low Stock (≤10)</option>
      <option value="nearexpiry">Near Expiry (30d)</option>
      <option value="expired">Expired</option>
    </select>
  </div>
</div>




  <!-- ===== TABLE CARD (full-bleed like d-history) ===== -->
  <div class="card-shell">
    <div class="table-wrap">
      <div class="table-responsive fixed-table-container">
        <table class="table table-inventory table-hover mb-0">
          <thead>
            <tr>
     <th>Name</th>
<th>Category</th>
<th>Purchased</th> <!-- NEW -->
<th>Price</th>
<th>Markup</th> 
<th>Quantity</th>
<th>Status</th>
<th>Expiration</th>
<th>Actions</th>

            </tr>
          </thead>
          <tbody id="inventoryTableBody"></tbody>
        </table>
      </div>
    </div>

    <!-- Pagination inside the card footer -->
    <div class="pagination-bar">
      <ul class="pagination justify-content-center" id="paginationControls"></ul>
    </div>
  </div>
</div>

<!-- ADD MODAL -->
<div class="modal fade" id="addModal" tabindex="-1" aria-labelledby="addModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <form id="inventoryForm" class="modal-content inventory-modal">
      <div class="modal-header">
        <h5 class="modal-title" id="addModalLabel">Add New Inventory Item</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span style="font-size:2rem;">&times;</span>
        </button>
      </div>

      <div class="modal-body">
        <div class="section-title">Basic Details</div>
        <div class="form-row">
          <div class="form-group col-md-6">
            <label for="itemName">Item Name</label>
            <input type="text" class="form-control" id="itemName" name="name" required autocomplete="off">
          </div>

          <div class="form-group col-md-6">
            <label for="itemCategorySelect">Category</label>
            <select class="form-control" id="itemCategorySelect" name="category" required>
              <option value="">Select Category</option>
            </select>
          </div>
        </div>
<div class="form-row">
  <div class="form-group col-md-6">
    <label for="purchaseDate">Purchase Date</label>
    <input type="date" class="form-control" id="purchaseDate" name="purchaseDate">
  </div>
</div>

        <div class="section-title">Inventory & Expiration</div>
        <div class="form-row">
          <div class="form-group col-md-4">
            <label for="itemBasePrice">Base Price (₱)</label>
            <input type="number" step="0.01" class="form-control" id="itemBasePrice" name="basePrice" required min="0">
          </div>

          <div class="form-group col-md-4">
            <label for="itemMarkup">Markup (₱)</label>
            <input type="number" step="0.01" class="form-control" id="itemMarkup" name="markup" value="0" min="0">
            <small id="addPricePreview" class="text-muted d-block mt-1"></small>
          </div>

          <div class="form-group col-md-4">
            <label for="itemQuantity">Quantity</label>
            <input type="number" class="form-control" id="itemQuantity" name="quantity" required min="1">
          </div>
        </div>

        <!-- One-date-for-all controls -->
        <div class="d-flex align-items-center mb-2" id="oneDateControls">
          <div class="custom-control custom-checkbox mr-3">
            <input type="checkbox" class="custom-control-input" id="useOneDate">
            <label class="custom-control-label" for="useOneDate">Use one expiration date for all</label>
          </div>
          <input type="date" class="form-control" id="oneExpirationDate" style="max-width:220px;" disabled>
          <button type="button" class="btn btn-outline-primary ml-2" id="applyDateToAll" disabled>Apply to all</button>
        </div>

        <div class="form-row">
          <div class="form-group col-md-12">
            <label>Expiration Dates</label>
            <div class="expiration-inputs" id="expirationDatesContainer">
              <small class="text-muted">Optional • Auto-generate based on quantity</small>
            </div>
          </div>
        </div>
      </div>

      <div class="modal-footer">
        <button type="submit" class="btn btn-primary">Add Item</button>
        <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">Cancel</button>
      </div>
    </form>
  </div>
</div>

<!-- EDIT MODAL -->
<div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <form id="editForm" class="modal-content inventory-modal">
      <div class="modal-header">
        <h5 class="modal-title" id="editModalLabel">Edit Inventory Item</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span style="font-size:2rem;">&times;</span>
        </button>
      </div>

      <div class="modal-body">
        <input type="hidden" id="editId" name="id">

        <div class="section-title">Basic Details</div>
        <div class="form-row">
          <div class="form-group col-md-6">
            <label for="editName">Item Name</label>
            <input type="text" class="form-control" id="editName" name="name" required autocomplete="off">
          </div>

          <div class="form-group col-md-6">
            <label for="editCategorySelect">Category</label>
            <select class="form-control" id="editCategorySelect" name="category" required>
              <option value="">Select Category</option>
            </select>
          </div>
        </div>
<div class="form-row">
  <div class="form-group col-md-6">
    <label for="editPurchaseDate">Purchase Date</label>
    <input type="date" class="form-control" id="editPurchaseDate" name="purchaseDate">
  </div>
</div>

        <div class="section-title">Inventory & Expiration</div>
        <div class="form-row">
          <div class="form-group col-md-4">
            <label for="editBasePrice">Base Price (₱)</label>
            <input type="number" step="0.01" class="form-control" id="editBasePrice" name="basePrice" required min="0">
          </div>

          <div class="form-group col-md-4">
            <label for="editMarkup">Markup (₱)</label>
            <input type="number" step="0.01" class="form-control" id="editMarkup" name="markup" value="0" min="0">
            <small id="editPricePreview" class="text-muted d-block mt-1"></small>
          </div>

          <div class="form-group col-md-4">
            <label for="editQuantity">Quantity</label>
            <input type="number" class="form-control" id="editQuantity" name="quantity" required min="1">
          </div>
        </div>

