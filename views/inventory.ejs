<!-- Scripts -->
<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
(function(){
  let currentPage = 1, itemsPerPage = 10, allInventory = [];
  const LOW_STOCK = 10;
function todayLocal(){
  const d = new Date();
  const yyyy = d.getFullYear();
  const mm = String(d.getMonth()+1).padStart(2,'0');
  const dd = String(d.getDate()).padStart(2,'0');
  return `${yyyy}-${mm}-${dd}`;
}

  // ---------- Categories ----------
  function loadCategories() {
    return $.get('/admin/get-categories').then(function(cats){
      cats = (Array.isArray(cats) ? cats : []).filter(Boolean).sort((a,b)=>a.localeCompare(b));
      const makeOpts = (includeBlank, blankText) =>
        (includeBlank ? '<option value="">' + blankText + '</option>' : '') +
        cats.map(c => '<option value="'+c+'">'+(c.charAt(0).toUpperCase()+c.slice(1))+'</option>').join('');

      $('#itemCategorySelect').html(makeOpts(true, 'Select Category'));
      $('#editCategorySelect').html(makeOpts(true, 'Select Category'));
      $('#categoryFilter').html(makeOpts(true, 'All Categories'));
    });
  }
// ---- Button spinner helpers ----
function enhanceButton($btn){
  if ($btn.data('spinnerified')) return;
  const label = $btn.html();
  $btn.html(
    '<span class="spinner-border spinner-border-sm mr-2 d-none" role="status" aria-hidden="true"></span>' +
    '<span class="btn-label">' + label + '</span>'
  );
  $btn.data('spinnerified', true);
}
function setBtnLoading($btn, on){
  enhanceButton($btn);
  $btn.prop('disabled', on);
  $btn.find('.spinner-border').toggleClass('d-none', !on);
}
function withDelayedSpinner($btn, jqPromise, delayMs=600){
  enhanceButton($btn);
  let timer = setTimeout(()=> setBtnLoading($btn, true), delayMs); // only show if "slow"
  $.when(jqPromise).always(function(){
    clearTimeout(timer);
    setBtnLoading($btn, false);
  });
}

  // ---------- Analytics (chart removed; keep metrics) ----------
function renderAnalytics(items) {
  const total = items.length;
  const lowStock = items.filter(i => liveQtyOf(i) <= LOW_STOCK).length;
  const nearExpiry = items.filter(i =>
    (i.expirationDates||[]).some(date=>{
      let d = new Date(date), diff = (d-new Date())/(1000*60*60*24);
      return diff > 0 && diff <= 30;
    })
  ).length;
const expiredCount = items.reduce((sum, i) => sum + expiredQtyOf(i), 0);


  $('#analytics-cards').html(`
    <div class="analytic-card"><div>Total Items</div><span>${total}</span></div>
    <div class="analytic-card"><div>Low Stock (&le;${LOW_STOCK})</div><span>${lowStock}</span></div>
    <div class="analytic-card"><div>Near Expiry (30d)</div><span>${nearExpiry}</span></div>
    <div class="analytic-card"><div>Expired</div><span>${expiredCount}</span></div>
  `);
}

// Sellable units = future-dated + undated (blank date inputs)
// Undated units are treated as valid/sellable stock.
function liveQtyOf(item) {
  const qty = Number(item.quantity || 0);
  const dates = Array.isArray(item.expirationDates) ? item.expirationDates : [];

  const today = new Date(); today.setHours(0,0,0,0);

  let valid = 0;   // how many date inputs are actually parsable dates
  let future = 0;  // how many of those dates are > today

  for (const d of dates) {
    const dt = new Date(d);
    if (!isNaN(dt)) {
      valid++;
      if (dt > today) future++;
    }
  }

  const undated = Math.max(0, qty - valid); // blanks = undated units
  return future + undated;
}

// Expired units = unique expiredDates + any valid date <= today
// Undated units are NOT considered expired.
function expiredQtyOf(item) {
  const qty = Number(item.quantity || 0);
  const expiredList = Array.isArray(item.expiredDates) ? item.expiredDates : [];
  const dates = Array.isArray(item.expirationDates) ? item.expirationDates : [];

  const today = new Date(); today.setHours(0,0,0,0);
  const key = (dt) => {
    const d = new Date(dt);
    if (isNaN(d)) return null;
    d.setHours(0,0,0,0);
    return d.getTime();
  };

  const seen = new Set();
  for (const d of expiredList) {
    const k = key(d);
    if (k !== null) seen.add(k);
  }

  // Count valid dated entries that are already expired (<= today)
  for (const d of dates) {
    const dt = new Date(d);
    if (!isNaN(dt) && dt <= today) {
      const k = key(dt);
      if (k !== null) seen.add(k);
    }
  }

  // Cap by total quantity so we never exceed actual stock
  return Math.min(seen.size, qty);
}

function nearExpiryDatesOf(item) {
  const now = new Date();
  const in30ms = 30 * 24 * 60 * 60 * 1000;
  return (Array.isArray(item.expirationDates) ? item.expirationDates : []).filter(d => {
    const dt = new Date(d);
    return !isNaN(dt) && dt > now && (dt - now) <= in30ms;
  });
}
function nearExpiryQtyOf(item) {
  return nearExpiryDatesOf(item).length;
}

  // ---------- Table Render ----------
  function renderTable(data) {
    const searchText = $('#searchBar').val().toLowerCase();
    const categoryFilter = $('#categoryFilter').val();
    const statusFilter = $('#statusFilter').val();
const isExpiredView = (statusFilter === "expired");

const isLowView     = (statusFilter === "lowstock");
const isNearView    = (statusFilter === "nearexpiry");


    let filtered = data.filter(item =>
      item.name.toLowerCase().includes(searchText) &&
      (!categoryFilter || item.category === categoryFilter)
    );

  if(statusFilter === "lowstock") {
  filtered = filtered.filter(item => liveQtyOf(item) <= LOW_STOCK);
}

    if(statusFilter === "nearexpiry") {
      filtered = filtered.filter(item =>
        (item.expirationDates||[]).some(date=>{
          let d = new Date(date), diff = (d-new Date())/(1000*60*60*24);
          return diff > 0 && diff <= 30;
        })
      );
    }
    if(statusFilter === "expired") {
      filtered = filtered.filter(item => (item.expiredDates||[]).length > 0);
    }

    const total = filtered.length, totalPages = Math.ceil(total/itemsPerPage);
    if(currentPage>totalPages) currentPage=totalPages||1;
    let paginated = filtered.slice((currentPage-1)*itemsPerPage, currentPage*itemsPerPage);

    let tbody = '';
    paginated.forEach(item=>{
        const purchasedRaw = item.purchaseDate || item.createdAt;
  const purchasedCell = purchasedRaw
    ? new Date(purchasedRaw).toLocaleDateString('en-US', { month:'short', day:'2-digit', year:'numeric' })
    : '—';

      
let status = '';
if (isExpiredView) {
  status = `<span class="badge badge-danger">Expired</span>`;
} else if (isLowView) {
  status = `<span class="badge badge-low mr-1">Low</span>`;
} else if (isNearView) {
  status = `<span class="badge badge-expiry">Expiring</span>`;
} else {
  if (liveQtyOf(item) <= LOW_STOCK) status += `<span class="badge badge-low mr-1">Low</span>`;
  else status += `<span class="badge badge-instock mr-1">In Stock</span>`;

  if ((item.expirationDates||[]).some(date=>{
    let d = new Date(date), diff = (d-new Date())/(1000*60*60*24);
    return diff > 0 && diff <= 30;
  })) status += `<span class="badge badge-expiry">Expiring</span>`;

  if ((item.expiredDates||[]).length > 0) status += `<span class="badge badge-danger">Expired</span>`;
}


let expDates;
if (isExpiredView) {
  expDates = (item.expiredDates||[]).length
    ? `<button class="btn btn-sm btn-outline-danger view-dates-btn"
               data-kind="expired"
               data-expdates='${JSON.stringify(item.expiredDates).replace(/"/g,'&quot;')}'>View</button>`
    : 'N/A';
} else if (isNearView) {
  const near = nearExpiryDatesOf(item);
  expDates = near.length
    ? `<button class="btn btn-sm btn-outline-info view-dates-btn"
               data-kind="near"
               data-expdates='${JSON.stringify(near).replace(/"/g,'&quot;')}'>View</button>`
    : 'N/A';
} else {
  expDates = (item.expirationDates||[]).length
    ? `<button class="btn btn-sm btn-outline-info view-dates-btn"
               data-kind="future"
               data-expdates='${JSON.stringify(item.expirationDates).replace(/"/g,'&quot;')}'>View</button>`
    : 'N/A';
}


     tbody += `
      <tr>
        <td>${item.name}</td>
        <td>${item.category}</td>
        <td>${purchasedCell}</td>   <!-- NEW -->
        <td>₱${parseFloat(item.price).toFixed(2)}</td>

        <td>₱${parseFloat(item.markup ?? 0).toFixed(2)}</td>  <!-- NEW -->
    <td>${
  isExpiredView ? expiredQtyOf(item) :
  isNearView    ? nearExpiryQtyOf(item) :
                  liveQtyOf(item)
}</td>


        <td>${status}</td>
        <td>${expDates}</td>
      <td>
  ${isExpiredView ? '' : `<button class="btn btn-sm btn-info edit-btn" data-id="${item._id}">Edit</button>`}
  <button class="btn btn-sm btn-danger delete-btn" data-id="${item._id}">Delete</button>
</td>

      </tr>`;
    });
    $('#inventoryTableBody').html(tbody);
    renderPagination(totalPages);
    renderAnalytics(filtered.length ? filtered : data);
  }

  function renderPagination(totalPages) {
    let html = '';
    if(totalPages<=1){ $('#paginationControls').html(''); return; }
    html += `<li class="page-item ${currentPage===1?'disabled':''}">
               <a class="page-link" href="#" data-page="${currentPage-1}">Previous</a>
             </li>`;
    for(let i=1;i<=totalPages;i++) html += `
      <li class="page-item ${currentPage===i?'active':''}">
        <a class="page-link" href="#" data-page="${i}">${i}</a>
      </li>`;
    html += `<li class="page-item ${currentPage===totalPages?'disabled':''}">
               <a class="page-link" href="#" data-page="${currentPage+1}">Next</a>
             </li>`;
    $('#paginationControls').html(html);
  }

  function loadInventory() {
    $.get('/admin/inventory/list', d=>{
      allInventory = d;
      renderTable(d);
    });
  }

  // ---------- Price Preview ----------
  function fmt(n){ return '₱' + (Number(n)||0).toFixed(2); }
  function updateAddPreview(){
    const b = parseFloat($('#itemBasePrice').val())||0;
    const m = parseFloat($('#itemMarkup').val())||0;
    $('#addPricePreview').text(`Selling Price = ${fmt(b)} + ${fmt(m)} = ${fmt(b+m)}`);
  }
  function updateEditPreview(){
    const b = parseFloat($('#editBasePrice').val())||0;
    const m = parseFloat($('#editMarkup').val())||0;
    $('#editPricePreview').text(`Selling Price = ${fmt(b)} + ${fmt(m)} = ${fmt(b+m)}`);
  }

  // ---------- Add modal: expiration controls ----------
  function getAddDateInputs() {
    return $('#expirationDatesContainer').find('input[type="date"][name="expirationDates[]"]');
  }
  function setAllDates(value) {
    const $inputs = getAddDateInputs();
    $inputs.each(function(){ $(this).val(value); });
  }
  function toggleOneDateControls(enabled) {
    $('#oneExpirationDate').prop('disabled', !enabled);
    $('#applyDateToAll').prop('disabled', !enabled);
  }
  function markAppliedState(applied){
    const $btn = $('#applyDateToAll');
    if (applied) {
      $btn.text('Applied to all').removeClass('btn-outline-primary').addClass('btn-success');
    } else {
      $btn.text('Apply to all').removeClass('btn-success').addClass('btn-outline-primary');
    }
  }
  function regenerateAddDateInputs(qty){
    qty = Math.max(0, parseInt(qty)||0);
    const c = $('#expirationDatesContainer');
    const existing = c.find('input[name="expirationDates[]"]').map(function(){ return $(this).val(); }).get();
    c.empty();
    for(let i=1;i<=qty;i++){
      const val = existing[i-1] || '';
      c.append('<label>Expiration Date '+i+'</label><input type="date" class="form-control mb-2" name="expirationDates[]" value="'+ val +'">');
    }
    const useOne = $('#useOneDate').is(':checked');
    const oneVal = $('#oneExpirationDate').val();
    toggleOneDateControls(qty > 0 && useOne);
    if (useOne && oneVal) { setAllDates(oneVal); markAppliedState(true); } else { markAppliedState(false); }
  }
  $('#itemQuantity').on('input change', function(){ regenerateAddDateInputs($(this).val()); });
  $('#useOneDate').on('change', function(){
    const checked = $(this).is(':checked');
    const qty = parseInt($('#itemQuantity').val())||0;
    toggleOneDateControls(checked && qty > 0);
    if (checked) {
      const v = $('#oneExpirationDate').val();
      if (v) { setAllDates(v); markAppliedState(true); }
    } else { markAppliedState(false); }
  });
  $('#oneExpirationDate').on('change', function(){
    if ($('#useOneDate').is(':checked')) {
      const v = $(this).val();
      if (v) { setAllDates(v); markAppliedState(true); }
    }
  });
  $('#applyDateToAll').on('click', function(){
    const v = $('#oneExpirationDate').val();
    if (!v) return;
    setAllDates(v);
    markAppliedState(true);
  });

  // ---------- Filters & pagination ----------
  $('#searchBar,#categoryFilter,#statusFilter').on('keyup change',()=>{ currentPage=1; renderTable(allInventory); });
  $('#paginationControls').on('click','a',function(e){
    e.preventDefault();
    let page = parseInt($(this).data('page'));
    if(!isNaN(page)) { currentPage=page; renderTable(allInventory); }
  });

// ADD FORM — submit (keep modal open on success)
$('#inventoryForm').off('submit').on('submit', function(e){
  e.preventDefault();
  const form = this;

  // Require a date when "Use one expiration date for all" is checked
  const qty    = parseInt($('#itemQuantity').val()) || 0;
  const useOne = $('#useOneDate').is(':checked');
  const oneVal = $('#oneExpirationDate').val();
  if (useOne && qty > 0 && !oneVal) {
    Swal.fire({
      icon:'info',
      title:'Expiration date required',
      text:'Please choose the date to apply to all units.',
      timer:1800,
      showConfirmButton:false
    });
    $('#oneExpirationDate').focus();
    return;
  }

  const $submit = $('#inventoryForm button[type="submit"]');
  setBtnLoading($submit, true);

  $.post('/admin/inventory/add', $(form).serialize())
    .done(function(res){
      // ✅ Do NOT close the modal—just toast and prep for next entry
      Swal.fire({
        icon:'success',
        title:'Added',
        text: res.message || 'Item saved.',
        timer:1200,
        showConfirmButton:false
      });

      // Keep some fields sticky for faster multi-entry
  const keep = {
  category: $('#itemCategorySelect').val(),
  basePrice: $('#itemBasePrice').val(),
  markup: $('#itemMarkup').val(),
  useOne: $('#useOneDate').is(':checked'),
  oneDate: $('#oneExpirationDate').val(),
  purchaseDate: $('#purchaseDate').val() // NEW
};


      // Soft reset: clear name/qty/dates, keep pricing/category
      form.reset();
      $('#expirationDatesContainer').empty();
      updateAddPreview();

      $('#itemCategorySelect').val(keep.category || '');
      $('#itemBasePrice').val(keep.basePrice || '');
      $('#itemMarkup').val(keep.markup || '');
      $('#useOneDate').prop('checked', !!keep.useOne);
      $('#oneExpirationDate').val(keep.oneDate || '');
      $('#purchaseDate').val(keep.purchaseDate || todayLocal()); // NEW


      // Controls will re-enable once quantity is set again
      toggleOneDateControls(false);
      markAppliedState(false);

      // Focus back to Item Name for the next add
      $('#itemName').focus();

      // Refresh table (no category reload needed here)
      loadInventory();
    })
    .fail(function(xhr){
      const msg = xhr.responseJSON?.error || 'Error adding item.';
      Swal.fire('Error', msg, 'error');
    })
    .always(function(){
      setBtnLoading($submit, false);
    });
});

  // Price previews
  $('#itemBasePrice,#itemMarkup').on('input', updateAddPreview);
  $('#editBasePrice,#editMarkup').on('input', updateEditPreview);

  // Edit inventory
 // Edit inventory (table "Edit" button) — show spinner on the button while loading
$('#inventoryTableBody').off('click', '.edit-btn').on('click', '.edit-btn', function(){
  const $btn = $(this);
  const id = $btn.data('id');

  // Build one promise that resolves when the modal is ready
  const p = $.get('/admin/inventory/item/' + id).then(item => {
    $('#editId').val(item._id);
    $('#editName').val(item.name);

    // Load categories, ensure current category is selectable
    return loadCategories().then(() => {
      const $sel = $('#editCategorySelect');
      if ($sel.find('option[value="'+ item.category +'"]').length === 0 && item.category) {
        $sel.append('<option value="'+item.category+'">'+(item.category.charAt(0).toUpperCase()+item.category.slice(1))+'</option>');
      }
      $sel.val(item.category);

      // Fill the rest
      $('#editBasePrice').val(item.basePrice);
      $('#editMarkup').val(item.markup);
      $('#editQuantity').val(item.quantity);
const pd = item.purchaseDate || item.createdAt;
$('#editPurchaseDate').val(pd ? String(pd).split('T')[0] : '');

      const c = $('#editExpirationDatesContainer'); c.empty();
      const qty = item.quantity || 0;
      for (let i=0;i<qty;i++) {
        const val = (item.expirationDates && item.expirationDates[i])
          ? String(item.expirationDates[i]).split("T")[0]
          : "";
        c.append('<label>Expiration Date '+(i+1)+'</label><input type="date" class="form-control mb-2" name="expirationDates[]" value="'+ val +'">');
      }

      updateEditPreview();
      $('#editModal').modal('show');
    });
  }).fail(() => {
    Swal.fire('Error','Error fetching item.','error');
  });

  // Only show spinner if slow (delayed)
  withDelayedSpinner($btn, p, 500);
});

  // Dynamic expiration dates for edit
  $('#editQuantity').on('change', function() {
    let qty = parseInt($(this).val()) || 0;
    let container = $('#editExpirationDatesContainer');
    let currentDates = [];
    container.find('input').each(function() { currentDates.push($(this).val()); });
    container.empty();
    for (let i = 1; i <= qty; i++) {
      let val = currentDates[i - 1] || "";
      container.append('<label>Expiration Date ' + i + '</label><input type="date" class="form-control mb-2" name="expirationDates[]" value="'+ val +'">');
    }
  });

  // Submit edit form
 // Submit edit form — spinner on "Save Changes"
$('#editForm').off('submit').on('submit', function(e){
  e.preventDefault();
  const $form   = $(this);
  const $submit = $('#editForm button[type="submit"]');
  setBtnLoading($submit, true);

  // 🔧 Remove blank expirationDates[] fields before serialize
  const $dateInputs = $form.find('input[name="expirationDates[]"]');
  $dateInputs.each(function(){
    if (!$(this).val()) {
      // Remove the name so it won't be serialized
      $(this).attr('data-was-name','expirationDates[]').removeAttr('name');
    }
  });

  const payload = $form.serialize();

  // Restore the names after serialization so UI remains intact if needed
  $form.find('input[data-was-name="expirationDates[]"]').attr('name','expirationDates[]').removeAttr('data-was-name');

  $.post('/admin/inventory/edit', payload)
    .done(res => {
      Swal.fire('Success', res.message, 'success');
      $('#editModal').modal('hide');
      setTimeout(function(){ loadInventory(); loadCategories(); }, 400);
    })
    .fail(() => {
      Swal.fire('Error','Error updating item.','error');
    })
    .always(() => {
      setBtnLoading($submit, false);
    });
});

  // Delete
// Delete (discard expired-only when in "Expired" filter)
$('#inventoryTableBody').on('click','.delete-btn',function(){
  const id = $(this).data('id');
  const isExpiredView = ($('#statusFilter').val() === 'expired');
  const title = isExpiredView ? 'Discard expired stock only?' : 'Delete this item?';
  const text  = isExpiredView
    ? 'Only expired units will be removed; sellable stock stays.'
    : 'This will remove the entire item.';

  Swal.fire({ title, text, icon:'warning', showCancelButton:true })
    .then(r=>{
      if(!r.isConfirmed) return;

      $.post('/admin/inventory/delete', { id, expiredOnly: isExpiredView })
        .done(res=>{
          Swal.fire('Done', res.message || 'Completed.', 'success');
          loadInventory();
          loadCategories();
        })
        .fail(()=> Swal.fire('Error','Error deleting item.','error'));
    });
});

$(document).off('click', '.view-dates-btn').on('click', '.view-dates-btn', function() {
  const $btn  = $(this);
  setBtnLoading($btn, true); // show spinner immediately

  let expDates = $btn.data('expdates');
  const kind   = $btn.data('kind') || 'future'; // 'expired' | 'near' | 'future'

  if (!Array.isArray(expDates)) {
    try { expDates = JSON.parse(expDates); } catch(e) { expDates = []; }
  }

  const $modal   = $('#viewDatesModal');
  const $dialog  = $modal.find('.modal-dialog');      // we'll toggle scroll here
  const $content = $modal.find('.modal-content');
  const $title   = $('#viewDatesModalLabel');

  // Header theme
  if (kind === 'expired') {
    $content.addClass('modal-expired');
    $title.text('Expired Dates');
  } else if (kind === 'near') {
    $content.removeClass('modal-expired');
    $title.text('Near Expiry Dates (≤ 30 days)');
  } else {
    $content.removeClass('modal-expired');
    $title.text('Expiration Dates');
  }

  // Body
  let html = '';
  if (!expDates.length) {
    html = '<p class="text-muted mb-0">No dates recorded.</p>';
  } else {
    expDates.forEach((date, i) => {
      const formatted = new Date(date).toLocaleDateString('en-US', {month:'long',day:'numeric',year:'numeric'});
      if (kind === 'expired') {
        html += `<p class="mb-1 expired-text">Expired on ${formatted}</p>`;
      } else if (kind === 'near') {
        html += `<p class="mb-1">Near expiry on ${formatted}</p>`;
      } else {
        html += `<p class="mb-1">Expiration Date ${i+1}: ${formatted}</p>`;
      }
    });
  }

  // Inject content
  $('#viewDatesContent').html(html);

  // 🚀 Make modal scrollable when 10+ items (Bootstrap 4 built-in)
  $dialog.toggleClass('modal-dialog-scrollable', (expDates.length >= 10));

  // Stop spinner when the modal finishes showing (fallback just in case)
  $modal.one('shown.bs.modal', function(){ setBtnLoading($btn, false); });
  setTimeout(() => setBtnLoading($btn, false), 1200);

  $modal.modal('show');
});

// Ensure modal resets look when closed
$('#viewDatesModal').on('hidden.bs.modal', function(){
  $(this).find('.modal-content').removeClass('modal-expired');
  $('#viewDatesModalLabel').text('Expiration Dates');
});


  // ====== Category Manager (modal) ======
  function fetchCategoriesFull() { return $.get('/admin/categories'); } // [{_id, name}]
  function escapeHtml(s){ return String(s||'').replace(/[&<>"']/g, m=>({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[m])); }
  function escapeAttr(s){ return escapeHtml(s).replace(/"/g,'&quot;'); }

  function renderCategoriesList(rows) {
    const html = rows.map(r => `
      <li class="list-group-item d-flex align-items-center justify-content-between" data-id="${r._id}">
        <div class="cat-view d-flex align-items-center" style="gap:.5rem;">
          <span class="cat-name">${escapeHtml(r.name)}</span>
        </div>
        <div class="cat-actions">
          <button class="btn btn-sm btn-outline-primary btn-rename">Rename</button>
          <button class="btn btn-sm btn-outline-danger btn-delete ml-2">Delete</button>
        </div>

        <div class="cat-edit d-none">
          <div class="input-group">
            <input type="text" class="form-control input-newname" value="${escapeAttr(r.name)}">
            <div class="input-group-append">
              <button class="btn btn-primary btn-save-rename">Save</button>
              <button class="btn btn-outline-secondary btn-cancel-rename">Cancel</button>
            </div>
          </div>
        </div>
      </li>
    `).join('');
    $('#categoriesList').html(html);
  }

  function refreshCategoriesUI() {
    return fetchCategoriesFull().then(rows => {
      renderCategoriesList(rows);
      return loadCategories();
    });
  }

  // Open Manage Categories → load list
$('#manageCategoriesModal').on('show.bs.modal', function(){
  const p = refreshCategoriesUI();               // existing fetch
  withDelayedSpinner($('#btnManageCategories'), p, 600); // show spinner only if slow
});

$('#addModal').on('show.bs.modal', function(){
  const p = loadCategories();                         // ensure category list is fresh
  withDelayedSpinner($('#btnOpenAddModal'), p, 600);  // delayed spinner on button

  // Default purchase date to today if blank
  const $pd = $('#purchaseDate');
  if (!$pd.val()) $pd.val(todayLocal());
});

  // Add category
// Add category (with spinner)
$('#btnAddCategory').off('click').on('click', function(){
  const $btn = $(this);
  const name = ($('#newCategoryName').val() || '').trim();
  if (!name) return Swal.fire('Oops', 'Please enter a category name.', 'info');

  setBtnLoading($btn, true);

  $.post('/admin/categories', { name })
    .done(() => {
      $('#newCategoryName').val('');
      refreshCategoriesUI();
      Swal.fire({ icon:'success', title:'Added', timer:1000, showConfirmButton:false });
    })
    .fail(xhr => {
      const msg = xhr.responseJSON?.error || 'Error adding category';
      Swal.fire('Error', msg, 'error');
    })
    .always(() => {
      setBtnLoading($btn, false);
    });
});

  // Rename (switch to edit mode)
  $('#categoriesList').on('click', '.btn-rename', function(){
    const li = $(this).closest('li');
    li.find('.cat-view, .cat-actions').addClass('d-none');
    li.find('.cat-edit').removeClass('d-none');
  });

  // Rename cancel
  $('#categoriesList').on('click', '.btn-cancel-rename', function(){
    const li = $(this).closest('li');
    li.find('.cat-edit').addClass('d-none');
    li.find('.cat-view, .cat-actions').removeClass('d-none');
  });

  // Save rename
// Save rename (with spinner)
$('#categoriesList').off('click', '.btn-save-rename').on('click', '.btn-save-rename', function(){
  const $btn = $(this);
  const li = $btn.closest('li');
  const id = li.data('id');
  const newName = (li.find('.input-newname').val() || '').trim();
  if (!newName) return Swal.fire('Oops', 'Please enter a new name.', 'info');

  setBtnLoading($btn, true);

  $.ajax({
    url: '/admin/categories/' + id,
    method: 'PATCH',
    data: { name: newName }
  })
  .done(()=>{
    refreshCategoriesUI();
    Swal.fire({ icon:'success', title:'Renamed', timer:1000, showConfirmButton:false });
  })
  .fail(xhr=>{
    const msg = xhr.responseJSON?.error || 'Error renaming category';
    Swal.fire('Error', msg, 'error');
  })
  .always(()=>{
    setBtnLoading($btn, false);
  });
});

  // Delete category
  $('#categoriesList').on('click', '.btn-delete', function(){
    const li = $(this).closest('li');
    const id = li.data('id');
    const name = li.find('.cat-name').text();

    Swal.fire({
      title: `Delete "${name}"?`,
      text: 'This cannot be undone.',
      icon: 'warning',
      showCancelButton: true
    }).then(res=>{
      if (!res.isConfirmed) return;
      $.ajax({ url: '/admin/categories/' + id, method: 'DELETE' })
        .done(()=>{
          refreshCategoriesUI();
          Swal.fire({ icon:'success', title:'Deleted', timer:1000, showConfirmButton:false });
        })
        .fail(xhr=>{
          const msg = xhr.responseJSON?.error || 'Error deleting category';
          Swal.fire('Error', msg, 'error');
        });
    });
  });

  // Initial Load
  $(function(){
    loadInventory();
    loadCategories();
    updateAddPreview();
    toggleOneDateControls(false);
    markAppliedState(false);
  });
  $(window).on('pageshow', function(e){
    if(e.originalEvent && e.originalEvent.persisted) { loadInventory(); loadCategories(); }
  });
})();
// Local guard for Add / Manage Categories / Edit / View Dates
$('#addModal, #manageCategoriesModal, #editModal, #viewDatesModal')
  .on('show.bs.modal', function(){
    $('#sidebarOverlay').removeClass('show');      // never double-dim
    setTimeout(function(){ $('.modal-backdrop').slice(0, -1).remove(); }, 0);
  });

</script>
</body>
</html>
