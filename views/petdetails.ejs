<%
// Ensure petDetails is defined for the partial.
var petDetails = (typeof petDetails !== 'undefined' && petDetails)
  ? petDetails
  : { species: [], speciesBreeds: {}, diseases: [], speciesDiseases: {}, services: [] };
%>

<!-- START: Pet Details Partial (no <html>, no <head>, no <body>) -->

<div class="container py-4">
  <h2 class="mb-4">Pet Details Settings</h2>

  <style>
    .section-header { display:flex; align-items:center; justify-content:space-between; }
    .section-header h4 { margin:0; }
    .search-box { max-width:300px; margin-left:auto; }
    .table-container { overflow-y:auto; max-height:250px; }
    .table-container::-webkit-scrollbar { width:4px; }
    .table-container::-webkit-scrollbar-track { background:transparent; }
    .table-container::-webkit-scrollbar-thumb { background-color:#888; border-radius:2px; }

    .modal-label { font-weight:600; margin-bottom:5px; }
    .inline-confirm { background:#f8d7da; border:1px solid #f5c6cb; padding:5px 10px; margin-top:5px; border-radius:4px; font-size:.85rem; color:#721c24; }
    .inline-confirm button { margin-right:5px; }

    .breed-search-container { display:flex; align-items:center; margin-bottom:10px; gap:12px; }
    #breedStatusMsg { flex:1; font-size:.9rem; min-height:1.2em; }
    .breed-add-msg { color:#28a745; }
    .breed-delete-msg { color:#dc3545; }
    .breed-search-box { width:50%; margin-left:auto; }
    #breedList { max-height:220px; overflow-y:auto; }
    #breedList::-webkit-scrollbar { width:4px; }
    #breedList::-webkit-scrollbar-track { background:transparent; }
    #breedList::-webkit-scrollbar-thumb { background-color:#888; border-radius:2px; }

    .swal2-container{ z-index: 6000 !important; } /* SweetAlert above modal */
  </style>

  <!-- ===================== 1) SPECIES/BREED SECTION ===================== -->
  <div class="card mb-4">
    <div class="card-header section-header">
      <h4><i class="fas fa-dog mr-2"></i>Species / Breed</h4>
    </div>
    <div class="card-body">
      <div class="input-group mb-3">
        <input type="text" class="form-control" id="newSpeciesInput" placeholder="Add new species..." />
        <div class="input-group-append">
          <button class="btn btn-primary" id="addSpeciesBtn">Add Species</button>
        </div>
      </div>

      <div class="form-group d-flex">
        <input type="text" class="form-control search-box" id="speciesSearch" placeholder="Search species...">
      </div>

      <div class="table-container">
        <table class="table table-bordered" id="speciesTable">
          <thead>
            <tr><th>Species</th><th>Action</th></tr>
          </thead>
          <tbody id="speciesTableBody">
            <% (petDetails.species || []).forEach(function(sp){ %>
              <tr>
                <td><%= sp %></td>
                <td>
                  <!-- IMPORTANT: data-toggle + data-target so Bootstrap passes relatedTarget -->
                  <button type="button"
                          class="btn btn-info btn-sm addBreedBtn"
                          data-toggle="modal" data-target="#addBreedModal"
                          data-species="<%= sp %>"
                          data-breeds='<%= JSON.stringify(petDetails.speciesBreeds[sp] || []) %>'>
                    Add Breed
                  </button>
                  <button class="btn btn-danger btn-sm deleteSpeciesBtn" data-species="<%= sp %>">Delete</button>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- ===================== 2) DISEASES SECTION ===================== -->
  <div class="card mb-4">
    <div class="card-header section-header">
      <h4><i class="fas fa-virus mr-2"></i>Diseases</h4>
    </div>

    <div class="card-body">
      <h5 class="mb-3">Global Diseases (fallback)</h5>
      <div class="input-group mb-3">
        <input type="text" class="form-control" id="newDiseaseInput" placeholder="Add new global disease..." />
        <div class="input-group-append">
          <button class="btn btn-primary" id="addDiseaseBtn">Add Global Disease</button>
        </div>
      </div>

      <div class="form-group d-flex">
        <input type="text" class="form-control search-box" id="diseaseSearch" placeholder="Search global disease...">
      </div>

      <div class="table-container mb-4">
        <table class="table table-bordered" id="diseaseTable">
          <thead>
            <tr><th>Disease Name</th><th style="width:120px;">Action</th></tr>
          </thead>
          <tbody id="diseaseTableBody">
            <% (petDetails.diseases || []).forEach(function(ds){ %>
              <tr>
                <td><%= ds %></td>
                <td><button class="btn btn-danger btn-sm deleteDiseaseBtn" data-disease="<%= ds %>">Delete</button></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <hr>

      <h5 class="mb-3">Diseases by Species</h5>
      <div class="form-row align-items-center">
        <div class="col-md-6 mb-2">
          <label class="mb-1" for="speciesForDisease">Select Species</label>
          <select id="speciesForDisease" class="form-control">
            <option value="">-- choose species --</option>
            <% (petDetails.species || []).forEach(function(sp){ %>
              <option value="<%= sp %>"><%= sp %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-6 mb-2">
          <label class="mb-1">Add Disease to Selected Species</label>
          <div class="input-group">
            <input type="text" class="form-control" id="newSpeciesDiseaseInput" placeholder="Enter disease name...">
            <div class="input-group-append">
              <button class="btn btn-success" id="addSpeciesDiseaseBtn" disabled>Add</button>
            </div>
          </div>
        </div>
      </div>

      <div class="d-flex mt-3 mb-2">
        <input type="text" class="form-control search-box" id="speciesDiseaseSearch" placeholder="Search diseases in selected species...">
      </div>

      <div class="table-container">
        <table class="table table-bordered" id="speciesDiseaseTable">
          <thead>
            <tr><th style="width:40%;">Species</th><th>Disease</th><th style="width:120px;">Action</th></tr>
          </thead>
          <tbody id="speciesDiseaseTableBody"></tbody>
        </table>
        <div id="speciesDiseaseEmpty" class="text-muted" style="display:none;">No diseases for this species yet.</div>
      </div>
    </div>
  </div>

  <!-- ===================== 3) SERVICES SECTION ===================== -->
  <div class="card mb-4">
    <div class="card-header section-header">
      <h4><i class="fas fa-briefcase-medical mr-2"></i>Services</h4>
    </div>
    <div class="card-body">
      <div class="input-group mb-3">
        <input type="text" class="form-control" id="newServiceInput" placeholder="Add new service..." />
        <div class="input-group-append">
          <button class="btn btn-primary" id="addServiceBtn">Add Service</button>
        </div>
      </div>
      <div class="form-group d-flex">
        <input type="text" class="form-control search-box" id="serviceSearch" placeholder="Search service...">
      </div>
      <div class="table-container">
        <table class="table table-bordered" id="serviceTable">
          <thead>
            <tr><th>Service Name</th><th>Action</th></tr>
          </thead>
          <tbody id="serviceTableBody">
            <% (petDetails.services || []).forEach(function(svc){ %>
              <tr>
                <td><%= svc %></td>
                <td><button class="btn btn-danger btn-sm deleteServiceBtn" data-service="<%= svc %>">Delete</button></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- ===== MODAL: Add Breeds ===== -->
<div class="modal fade" id="addBreedModal" tabindex="-1" role="dialog" aria-labelledby="addBreedLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="addBreedLabel">Manage Breeds</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <div class="form-group">
          <label class="modal-label">Species</label>
          <input type="text" id="breedSpeciesInput" class="form-control" readonly>
        </div>

        <div class="breed-search-container">
          <div id="breedStatusMsg"></div>
          <input type="text" id="breedListSearch" class="form-control breed-search-box" placeholder="Search breeds...">
        </div>

        <div class="form-row">
          <div class="col-md-7">
            <label class="modal-label d-block">Breeds</label>
            <ul class="list-group" id="breedList"></ul>
          </div>
          <div class="col-md-5">
            <label class="modal-label d-block">Add a breed</label>
            <div class="input-group mb-2">
              <input type="text" id="newBreedInput" class="form-control" placeholder="e.g. Siberian Husky">
              <div class="input-group-append">
                <button type="button" id="addBreedToListBtn" class="btn btn-primary">Add</button>
              </div>
            </div>
            <small class="text-muted">Breeds are saved only after you click “Save Changes”.</small>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
        <button type="button" class="btn btn-success" id="saveBreedsBtn">Save Changes</button>
      </div>
    </div>
  </div>
</div>

<!-- Keep SweetAlert (shell doesn’t load it globally) -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
(function petDetailsInit(){
  // ===== clear previous handlers for hot re-entry via SPA =====
  $(document).off('.petdetails');

  // ===== state & helpers =====
  let tempBreedList = [];

  function filterBreedList() {
    const term = ($('#breedListSearch').val() || '').trim().toLowerCase();
    $('#breedList li').each(function(){
      const b = ($(this).data('breed') || '').toLowerCase();
      const match = b.indexOf(term) === 0 || b.includes(term);
      $(this).toggleClass('d-none', !match).toggleClass('d-flex', match);
    });
  }

  function renderBreedList() {
    const $list = $('#breedList').empty();
    tempBreedList.forEach((breed, i) => {
      $list.append(
        '<li class="list-group-item d-flex justify-content-between align-items-center" data-breed="'+
        String(breed).toLowerCase()+'">'+
          '<span>'+breed+'</span>'+
          '<button type="button" class="btn btn-danger btn-sm removeBreedBtn" data-index="'+i+'">Remove</button>'+
        '</li>'
      );
    });
    filterBreedList();
  }

  function setupSearchFilter(inputSel, tbodySel){
    $(document).on('keyup.petdetails', inputSel, function(){
      const v = ($(this).val() || '').toLowerCase();
      $(tbodySel).find('tr').each(function(){
        $(this).toggle($(this).text().toLowerCase().indexOf(v) > -1);
      });
    });
  }

  // ===== wire search filters =====
  setupSearchFilter('#speciesSearch', '#speciesTableBody');
  setupSearchFilter('#diseaseSearch', '#diseaseTableBody');
  setupSearchFilter('#serviceSearch', '#serviceTableBody');
  setupSearchFilter('#speciesDiseaseSearch', '#speciesDiseaseTableBody');
  $(document).on('keyup.petdetails', '#breedListSearch', filterBreedList);

  // ===== Diseases by species: helpers & events =====
  function renderSpeciesDiseases(species, diseases) {
    const $tbody = $('#speciesDiseaseTableBody').empty();
    const $empty = $('#speciesDiseaseEmpty');
    if (!species) { $empty.text('Select a species to view its diseases.').show(); return; }
    if (!Array.isArray(diseases) || diseases.length === 0) { $empty.text('No diseases for this species yet.').show(); return; }
    $empty.hide();
    diseases.forEach(function(d) {
      const row =
        '<tr>' +
          '<td>' + species + '</td>' +
          '<td>' + d + '</td>' +
          '<td><button class="btn btn-danger btn-sm deleteSpeciesDiseaseBtn" data-species="'+species+'" data-disease="'+d+'">Delete</button></td>' +
        '</tr>';
      $tbody.append(row);
    });
  }

  function loadSpeciesDiseases(species) {
    $('#speciesDiseaseTableBody').empty();
    $('#speciesDiseaseEmpty').text('Loading…').show();
    $.get('/admin/settings/species-diseases', { species: species })
      .done(function(res){
        if (res && res.success) renderSpeciesDiseases(species, res.diseases || []);
        else $('#speciesDiseaseEmpty').text('Error loading diseases.').show();
      })
      .fail(function(){ $('#speciesDiseaseEmpty').text('Server error loading diseases.').show(); });
  }

  $(document).on('change.petdetails', '#speciesForDisease', function(){
    const species = ($(this).val() || '').trim();
    $('#addSpeciesDiseaseBtn').prop('disabled', !species);
    $('#newSpeciesDiseaseInput').val('');
    if (species) loadSpeciesDiseases(species);
    else renderSpeciesDiseases('', []);
  });

  $(document).on('click.petdetails', '#addSpeciesDiseaseBtn', function(){
    const species = ($('#speciesForDisease').val() || '').trim();
    const disease = ($('#newSpeciesDiseaseInput').val() || '').trim();
    if (!species) { Swal.fire('Select Species','Please choose a species first.','warning'); return; }
    if (!disease) { $('#newSpeciesDiseaseInput').addClass('is-invalid'); return; }
    $('#newSpeciesDiseaseInput').removeClass('is-invalid');

    const $btn = $(this).prop('disabled', true)
      .html('<span class="spinner-border spinner-border-sm mr-2" role="status"></span>Adding...');
    $.post('/admin/settings/species-disease/add', { species, disease })
      .done(function(res){
        if (res && res.success) {
          $('#newSpeciesDiseaseInput').val('');
          renderSpeciesDiseases(species, res.diseases || []);
          Swal.fire({icon:'success', title:'Added', text:'Disease added to '+species+'.'});
        } else {
          Swal.fire('Error', res.message || 'Error adding disease.','error');
        }
      })
      .fail(function(){ Swal.fire('Error','Server error while adding disease.','error'); })
      .always(function(){ $btn.prop('disabled', false).text('Add'); });
  });

  $(document).on('click.petdetails', '.deleteSpeciesDiseaseBtn', function(){
    const species = $(this).data('species');
    const disease = $(this).data('disease');
    Swal.fire({
      title:'Delete Disease?',
      text:'Remove "'+disease+'" from '+species+'?',
      icon:'warning', showCancelButton:true,
      confirmButtonText:'Yes, delete', cancelButtonText:'Cancel'
    }).then(function(r){
      if (!r.isConfirmed) return;
      $.post('/admin/settings/species-disease/delete', { species, disease })
        .done(function(res){
          if (res && res.success) {
            renderSpeciesDiseases(species, res.diseases || []);
            Swal.fire({icon:'success', title:'Deleted', text:'Disease removed from '+species+'.'});
          } else {
            Swal.fire('Error', res.message || 'Error deleting disease.','error');
          }
        })
        .fail(function(){ Swal.fire('Error','Server error while deleting disease.','error'); });
    });
  });

  // Auto-select first species in dropdown
  $(function(){
    const first = ($('#speciesForDisease option:eq(1)').val() || '');
    if (first) { $('#speciesForDisease').val(first).trigger('change'); }
  });

  // ===== SPECIES: Add =====
  $(document).on('click.petdetails', '#addSpeciesBtn', function(){
    const newSpecies = ($('#newSpeciesInput').val() || '').trim();
    if(!newSpecies){ $('#newSpeciesInput').addClass('is-invalid'); return; }
    $('#newSpeciesInput').removeClass('is-invalid');

    const $btn = $(this).prop('disabled', true)
      .html('<span class="spinner-border spinner-border-sm mr-2" role="status"></span>Adding...');
    $.ajax({ url:'/settings/add-species', method:'POST', data:{ species:newSpecies } })
      .done(function(res){
        if(res.success){
          $('#speciesTableBody').append(
            '<tr>'+
              '<td>'+newSpecies+'</td>'+
              '<td>'+
                '<button type="button" class="btn btn-info btn-sm addBreedBtn" '+
                ' data-toggle="modal" data-target="#addBreedModal" '+
                ' data-species="'+newSpecies+'" data-breeds="[]">Add Breed</button> '+
                '<button class="btn btn-danger btn-sm deleteSpeciesBtn" data-species="'+newSpecies+'">Delete</button>'+
              '</td>'+
            '</tr>'
          );
          $('#newSpeciesInput').val('');
          Swal.fire({icon:'success', title:'Added', text:'Successfully added "'+newSpecies+'".'});
        } else {
          $('#newSpeciesInput').addClass('is-invalid');
          Swal.fire('Error', res.message || 'Error adding species.', 'error');
        }
      })
      .fail(function(){
        $('#newSpeciesInput').addClass('is-invalid');
        Swal.fire('Error','Server error while adding species.','error');
      })
      .always(function(){ $btn.prop('disabled', false).html('Add Species'); });
  });

  // ===== SPECIES: Delete =====
  $(document).on('click.petdetails', '.deleteSpeciesBtn', function(){
    const species = $(this).data('species');
    Swal.fire({
      title:'Delete Species?', text:'Are you sure you want to delete "'+species+'"?',
      icon:'warning', showCancelButton:true, confirmButtonText:'Yes, delete it', cancelButtonText:'Cancel'
    }).then(function(r){
      if(!r.isConfirmed) return;
      $.post('/settings/delete-species', { species })
        .done(function(res){
          if(res.success){
            Swal.fire({icon:'success', title:'Deleted', text:'Species "'+species+'" has been removed.'});
            $('#speciesTableBody tr').filter(function(){
              return $(this).find('td:first').text() === species;
            }).remove();
          } else {
            Swal.fire('Error', res.message || 'Error deleting species.', 'error');
          }
        })
        .fail(function(){ Swal.fire('Error','Server error while deleting species.','error'); });
    });
  });

  // ===== BREED MODAL: populate & open (works for both data-API and manual) =====
  function populateBreedModalFromButton($btn){
    const species = ($btn && $btn.data('species')) ? String($btn.data('species')) : '';
    let breedsAttr = ($btn && $btn.attr('data-breeds')) ? $btn.attr('data-breeds') : '[]';
    try { tempBreedList = JSON.parse(breedsAttr || '[]'); } catch(e){ tempBreedList = []; }

    $('#breedSpeciesInput').val(species);
    $('#newBreedInput').val('');
    $('#breedListSearch').val('');
    $('#breedStatusMsg').empty();
    renderBreedList();
  }

  let __lastBreedBtn = null;

  $(document).on('click.petdetails', '.addBreedBtn', function(){
    __lastBreedBtn = $(this);
    populateBreedModalFromButton(__lastBreedBtn);
    $('#addBreedModal').modal('show');
  });

  $('#addBreedModal').on('show.bs.modal', function(evt){
    const $btn = $(evt.relatedTarget || __lastBreedBtn || []);
    if ($btn && $btn.length) {
      __lastBreedBtn = $btn;
      populateBreedModalFromButton($btn);
    }
  });

  // ===== BREEDS: Add to temp list =====
  $(document).on('click.petdetails', '#addBreedToListBtn', function(e){
    e.preventDefault();
    const newBreed = ($('#newBreedInput').val() || '').trim();
    if(!newBreed){ $('#newBreedInput').addClass('is-invalid'); return; }
    $('#newBreedInput').removeClass('is-invalid');

    // case-insensitive duplicate check
    const exists = tempBreedList.some(b => String(b).toLowerCase() === newBreed.toLowerCase());
    if(exists){
      $('#newBreedInput').addClass('is-invalid');
      Swal.fire('Error','Breed "'+newBreed+'" is already in the list.','error');
      return;
    }
    tempBreedList.push(newBreed);
    $('#newBreedInput').val('');
    renderBreedList();
    $('#breedStatusMsg').html('<span class="breed-status-msg breed-add-msg">Added "'+newBreed+'".</span>');
    setTimeout(function(){ $('#breedStatusMsg').empty(); }, 1500);
  });

  // ===== BREEDS: Remove =====
  $(document).on('click.petdetails', '.removeBreedBtn', function(){
    const idx = Number($(this).data('index'));
    const name = tempBreedList[idx];
    Swal.fire({
      title:'Delete Breed?', text:'Are you sure you want to remove "'+name+'"?',
      icon:'warning', showCancelButton:true, confirmButtonText:'Yes, remove it', cancelButtonText:'Cancel'
    }).then(function(r){
      if(!r.isConfirmed) return;
      tempBreedList.splice(idx, 1);
      renderBreedList();
      $('#breedStatusMsg').html('<span class="breed-delete-msg">Removed "'+name+'"</span>');
      setTimeout(function(){ $('#breedStatusMsg').empty(); }, 1500);
    });
  });

  // ===== BREEDS: Save Changes =====
  $(document).on('click.petdetails', '#saveBreedsBtn', function(e){
    e.preventDefault();
    const species = ($('#breedSpeciesInput').val() || '').trim();
    if (!species){
      Swal.fire('Missing species','Please open the modal from an “Add Breed” button so the species is set.','warning');
      return;
    }
    const $btn = $(this).prop('disabled', true)
      .html('<span class="spinner-border spinner-border-sm mr-2" role="status"></span>Saving...');
    $.ajax({ url:'/admin/settings/update-breeds', method:'POST', data:{ species, breeds: JSON.stringify(tempBreedList) } })
      .done(function(res){
        if(res && res.success){
          Swal.fire({icon:'success', title:'Saved', text:'Breeds updated for '+species+'.'});
          // keep button state in table in sync
          $('.addBreedBtn[data-species="'+species+'"]').attr('data-breeds', JSON.stringify(tempBreedList));
        } else {
          Swal.fire('Error', (res && res.message) || 'Error saving breeds.', 'error');
        }
      })
      .fail(function(xhr){
        Swal.fire('Error','Server error while updating breeds.','error');
        console.error('update-breeds failed', xhr && xhr.responseText);
      })
      .always(function(){ $btn.prop('disabled', false).html('Save Changes'); });
  });

  // ===== GLOBAL DISEASES =====
  $(document).on('click.petdetails', '#addDiseaseBtn', function(){
    const newDisease = ($('#newDiseaseInput').val() || '').trim();
    if(!newDisease){ $('#newDiseaseInput').addClass('is-invalid'); return; }
    $('#newDiseaseInput').removeClass('is-invalid');

    const $btn = $(this).prop('disabled', true)
      .html('<span class="spinner-border spinner-border-sm mr-2" role="status"></span>Adding...');
    $.post('/settings/add-disease', { disease:newDisease })
      .done(function(res){
        if(res.success){
          $('#diseaseTableBody').append(
            '<tr><td>'+newDisease+'</td>'+
            '<td><button class="btn btn-danger btn-sm deleteDiseaseBtn" data-disease="'+newDisease+'">Delete</button></td></tr>'
          );
          $('#newDiseaseInput').val('');
          Swal.fire({icon:'success', title:'Added', text:'Successfully added "'+newDisease+'".'});
        } else {
          $('#newDiseaseInput').addClass('is-invalid');
          Swal.fire('Error', res.message || 'Error adding disease.', 'error');
        }
      })
      .fail(function(){
        $('#newDiseaseInput').addClass('is-invalid');
        Swal.fire('Error','Server error while adding disease.','error');
      })
      .always(function(){ $btn.prop('disabled', false).html('Add Global Disease'); });
  });

  $(document).on('click.petdetails', '.deleteDiseaseBtn', function(){
    const disease = $(this).data('disease');
    Swal.fire({
      title:'Delete Disease?', text:'Are you sure you want to delete "'+disease+'"?',
      icon:'warning', showCancelButton:true, confirmButtonText:'Yes, delete', cancelButtonText:'Cancel'
    }).then(function(r){
      if(!r.isConfirmed) return;
      $.post('/settings/delete-disease', { disease })
        .done(function(res){
          if(res.success){
            Swal.fire({icon:'success', title:'Deleted', text:'Disease "'+disease+'" has been removed.'});
            $('#diseaseTableBody tr').filter(function(){
              return $(this).find('td:first').text() === disease;
            }).remove();
          } else {
            Swal.fire('Error', res.message || 'Error deleting disease.', 'error');
          }
        })
        .fail(function(){ Swal.fire('Error','Server error while deleting disease.','error'); });
    });
  });

  // ===== SERVICES =====
  $(document).on('click.petdetails', '#addServiceBtn', function(){
    const newService = ($('#newServiceInput').val() || '').trim();
    if(!newService){ $('#newServiceInput').addClass('is-invalid'); return; }
    $('#newServiceInput').removeClass('is-invalid');

    const $btn = $(this).prop('disabled', true)
      .html('<span class="spinner-border spinner-border-sm mr-2" role="status"></span>Adding...');
    $.post('/settings/add-service', { service:newService })
      .done(function(res){
        if(res.success){
          $('#serviceTableBody').append(
            '<tr><td>'+newService+'</td>'+
            '<td><button class="btn btn-danger btn-sm deleteServiceBtn" data-service="'+newService+'">Delete</button></td></tr>'
          );
          $('#newServiceInput').val('');
          Swal.fire({icon:'success', title:'Added', text:'Successfully added "'+newService+'".'});
        } else {
          $('#newServiceInput').addClass('is-invalid');
          Swal.fire('Error', res.message || 'Error adding service.', 'error');
        }
      })
      .fail(function(){
        $('#newServiceInput').addClass('is-invalid');
        Swal.fire('Error','Server error while adding service.','error');
      })
      .always(function(){ $btn.prop('disabled', false).html('Add Service'); });
  });

  $(document).on('click.petdetails', '.deleteServiceBtn', function(){
    const service = $(this).data('service');
    Swal.fire({
      title:'Delete Service?', text:'Are you sure you want to delete "'+service+'"?',
      icon:'warning', showCancelButton:true, confirmButtonText:'Yes, delete', cancelButtonText:'Cancel'
    }).then(function(r){
      if(!r.isConfirmed) return;
      $.post('/settings/delete-service', { service })
        .done(function(res){
          if(res.success){
            Swal.fire({icon:'success', title:'Deleted', text:'Service "'+service+'" has been removed.'});
            $('#serviceTableBody tr').filter(function(){
              return $(this).find('td:first').text() === service;
            }).remove();
          } else {
            Swal.fire('Error', res.message || 'Error deleting service.', 'error');
          }
        })
        .fail(function(){ Swal.fire('Error','Server error while deleting service.','error'); });
    });
  });

  // ===== Optional front-end "My Pet" helpers =====
  $(document).on('change.petdetails', '#species', function(){
    const selectedSpecies = $(this).val();
    const $breed = $('#petBreed').empty().append('<option value="">Select breed</option>');
    if(!selectedSpecies) return;
    $.get('/customer/get-pet-details')
      .done(function(data){
        (data.speciesBreeds[selectedSpecies] || []).forEach(function(b){ $breed.append('<option value="'+b+'">'+b+'</option>'); });
      })
      .fail(function(){ Swal.fire('Error','Server error fetching pet details.','error'); });
  });

  $(document).on('change.petdetails', '#existingDisease', function(){
    ($(this).val() === 'Other') ? $('#otherDisease').removeClass('d-none') : $('#otherDisease').addClass('d-none').val('');
  });

  $(document).on('change.petdetails', '#petPic', function(){
    const f = this.files && this.files[0];
    if(!f) return;
    const rd = new FileReader();
    rd.onload = function(e){
      $('#petPicPreview').html('<img src="'+e.target.result+'" alt="Pet Picture" class="img-thumbnail" style="width:100px;height:100px;object-fit:cover;">');
    };
    rd.readAsDataURL(f);
  });
})(); // end IIFE
</script>
