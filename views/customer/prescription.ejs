<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Prescription - Casa Animalia</title>
  <style>
    * { box-sizing: border-box; }
    body { font-family: Arial, sans-serif; margin: 0; padding: 0; color:#222; }
    .prescription { width: 800px; max-width: 100%; margin: 20px auto; padding: 24px; }

    /* Letterhead */
    .letterhead { display:flex; align-items:center; gap:16px; }
    .letterhead .logo { height:58px; width:auto; }
    .clinic-info { line-height:1.25; }
    .clinic-info .name { font-size: 20px; font-weight: 700; text-transform: uppercase; }
    .clinic-info .meta { font-size: 12px; color: #555; }

    .rule { border: 0; border-top: 2px solid #111; margin: 12px 0 18px; }

    /* Title */
    .doc-title {
      font-size: 18px; font-weight: 800; letter-spacing: .6px;
      text-align: center; margin: 6px 0 16px; text-transform: uppercase;
    }

    /* Patient / date */
    .patient-details { margin: 6px 0 18px; font-size: 14px; }
    .row { display:flex; gap:10px; margin: 6px 0; }
    .label { width: 130px; font-weight: 700; color:#333; }

    /* Meds table */
    .med-table { width:100%; border-collapse: collapse; margin: 8px 0 26px; }
    .med-table th, .med-table td {
      border: 1px solid #333; padding: 8px 10px; text-align: left; font-size: 14px;
    }
    .med-table th { background: #f2f2f2; }

    /* Issuer / IDs row */
    .issuer { display:flex; justify-content:flex-end; margin-top:22px; }
    .id-row { font-size:14px; color:#222; white-space:nowrap; }
    .id-row .id-label { font-weight:700; margin-right:6px; }
    .id-row .line {
      display:inline-block; vertical-align:baseline;
      min-width: 140px; border-bottom: 1px solid #000;
      line-height: 1.15; padding-bottom: 2px; text-align:left;
    }
    .id-row .spacer { display:inline-block; width:18px; }
    .id-row .underline {
      display:inline-block; border-bottom:1px solid #000;
      line-height:1.15; padding:0 2px 2px;
    }

    /* Footer */
    .footer {
      margin-top: 24px; font-size: 12px; text-align: center; color: #555;
      border-top: 1px solid #ddd; padding-top: 10px;
    }
  </style>
</head>
<body>
  <div class="prescription">
    <!-- Letterhead -->
    <div class="letterhead">
<img src="<%= logoSrc %>" alt="Casa Animalia Logo" class="logo">

      <div class="clinic-info">
        <div class="name">Casa Animalia Veterinary Clinic &amp; Grooming Center</div>
        <div class="meta">Km. 111 Maharlika Highway, Cabanatuan City</div>
        <div class="meta">0915-081-1294</div>
      </div>
    </div>
    <hr class="rule">

    <div class="doc-title">Prescription</div>

    <!-- Sensible issue date + doctor info -->
    <%
      var issuedAt = (reservation && (
        (reservation.schedule && reservation.schedule.scheduleDate) ||
        reservation.date || reservation.createdAt
      )) || Date.now();

      var doctorName = (reservation && reservation.doctor && reservation.doctor.username)
        ? reservation.doctor.username
        : '________________';

      // Keep LICENSE number (fill from doctor if available, otherwise show a blank line)
      var licenseNo = (reservation && reservation.doctor &&
        (reservation.doctor.licenseNo || reservation.doctor.license || reservation.doctor.prc)) || '';
    %>

    <!-- Patient & date -->
    <div class="patient-details">
      <div class="row">
        <span class="label">Date:</span>
        <span><%= new Date(issuedAt).toLocaleDateString() %></span>
      </div>
      <div class="row">
        <span class="label">Name of Pet:</span>
        <span><%= reservation.pets.map(function(p){ return p.petName; }).join(', ') %></span>
      </div>
    </div>

    <!-- Medications -->
    <% if (Array.isArray(reservation.medications) && reservation.medications.length) { %>
      <table class="med-table">
        <thead>
          <tr>
            <th>Medicine</th>
            <th>Qty</th>
          </tr>
        </thead>
        <tbody>
          <% reservation.medications.forEach(function(m){ %>
            <tr>
              <td><%= m.name || m.medicationName %></td>
              <td><%= (m.quantity != null ? m.quantity : '—') %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } else { %>
      <div style="font-size:14px; margin-bottom:22px;">No medications recorded.</div>
    <% } %>

    <!-- IDs row: keep License #, and show PTR #: Dr. Name (underlined) -->
    <div class="issuer">
      <div class="id-row">
        <span class="id-label">License #:</span>
        <span class="line"><%= licenseNo %></span>
        <span class="spacer"></span>
        <span class="id-label">PTR #:</span>
        <span class="underline">Dr. <%= doctorName %>, DVM</span>
      </div>
    </div>

    <!-- Policy / note -->
    <div class="footer">
      This prescription is generated by Casa Animalia and is valid for 30 days from the date issued.
      For verification, please contact the clinic using the numbers above.
    </div>
  </div>
</body>
</html>
