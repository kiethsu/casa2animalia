      details: (s.details || s.detail || s.description || ''),
      file: (s.file || null)
    })) : [];

    const medications = Array.isArray(r.medications) ? r.medications.map(m => ({
      name: (m.name || m.medicationName || ''),
      quantity: (m.quantity != null ? m.quantity : '—'),
      dosage: (m.dosage || '—'),
      remarks: (m.remarks || '—')
